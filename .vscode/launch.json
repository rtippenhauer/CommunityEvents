{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Debug NestJS API",
      "type": "node",
      "request": "launch",
      "program": "${workspaceFolder}/api/src/main.ts",
      "runtimeArgs": ["-r", "ts-node/register"],
      "cwd": "${workspaceFolder}/api",
      "env": { "NODE_ENV": "development" },
      "sourceMaps": true,
      "outFiles": ["${workspaceFolder}/api/dist/**/*.js"]
    }
  ]
}
