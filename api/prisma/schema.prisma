// Single source of truth for the CommunityEvents data model (REQ-TENANT-01.3).
//
// Originally generated by `prisma db pull` against a local database built by
// running the inherited v1 TypeORM migrations, so the bulk of it describes the
// v1 schema as it existed, not a redesign. Tenant scoping has since been layered
// on: the `tenants` table in v2-3, and a `tenant_id` column on every
// tenant-scoped model in v2-5.
//
// Whether a model carries `tenant_id` is not a free choice made here — the
// split is declared in api/src/common/tenant/tenant-scoped-models.ts, which is
// exhaustive over Prisma.ModelName and fails the build if a model is added
// without being classified. Adding `tenant_id` to a model means adding it to
// the SCOPED list there in the same change, and vice versa; the two are checked
// against each other by tenant-scoped-models.spec.ts.
//
// Every `tenant_id` carries `@default(0)`, which is a sentinel and never a real
// value. Its only job is to make Prisma's generated create inputs treat the
// field as optional, so the ~100 create() call sites do not each have to pass a
// tenant id by hand -- hand-written scoping at the call site being precisely
// what REQ-TENANT-01.3 rules out. The extension fills the real value in. Because
// `tenants.id` is AUTO_INCREMENT it is never 0, so the foreign key rejects the
// sentinel outright: a create that escapes the extension fails at the database
// instead of quietly writing a row that belongs to no tenant.
//
// Scalar fields are camelCase with @map to their snake_case columns. This is
// not cosmetic: controllers return records straight to the client, so a field
// name here IS the JSON key the Angular frontend consumes. Introspection named
// them after the columns (is_active, created_at), which would have quietly
// reshaped every API response the moment a service moved onto Prisma. The
// names now match the TypeORM entity properties one for one, verified across
// all 37 entities.
//
// That includes reproducing the entities' own inconsistencies -- announcements
// exposes the created_by column as `createdBy` while events, locations and
// event_guest_links expose it as `createdById`. Normalising those would be a
// breaking API change disguised as a cleanup, so the schema matches what each
// entity actually returns.
//
// Model names are left as the raw table names (snake_case, plural). Those are
// only ever used in code (prisma.event_rsvps), never serialised, so renaming
// them buys nothing here and would touch every call site in the same change
// that removes TypeORM.
//
// TypeORM's own `migrations` bookkeeping table is deliberately absent. It came
// back from introspection because it existed in the database that was pulled,
// but v2 starts from a blank database with the schema owned by a single Prisma
// migration, so there is no TypeORM history to record and Prisma tracks its
// own state in `_prisma_migrations`.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
}

model achievements {
  id                 Int                         @id @default(autoincrement()) @db.UnsignedInt
  key                String                      @unique(map: "uq_achievements_key") @db.VarChar(64)
  name               String                      @db.VarChar(120)
  description        String                      @db.VarChar(500)
  icon               String                      @default("emoji_events") @db.VarChar(255)
  imagePath          String?                     @map("image_path") @db.VarChar(500)
  progressType       achievements_progress_type? @map("progress_type")
  progressTarget     Int?                        @map("progress_target") @db.UnsignedInt
  eventId            Int?                        @map("event_id") @db.UnsignedInt
  points             Int                         @default(0) @db.TinyInt
  title              String?                     @db.VarChar(100)
  isSecret           Boolean                     @default(false) @map("is_secret")
  createdAt          DateTime                    @default(now()) @map("created_at") @db.DateTime(0)
  events             events?                     @relation(fields: [eventId], references: [id], onUpdate: NoAction, map: "fk_achievements_event")
  memberAchievements member_achievements[]

  @@index([eventId], map: "fk_achievements_event")
}

model announcement_comments {
  id             Int           @id @default(autoincrement()) @db.UnsignedInt
  announcementId Int           @map("announcement_id") @db.UnsignedInt
  userId         Int           @map("user_id") @db.UnsignedInt
  body           String        @db.Text
  editedAt       DateTime?     @map("edited_at") @db.DateTime(0)
  createdAt      DateTime      @default(now()) @map("created_at") @db.DateTime(0)
  deletedAt      DateTime?     @map("deleted_at") @db.DateTime(0)
  announcement   announcements @relation(fields: [announcementId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_ann_comment_ann")
  user           users         @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_ann_comment_user")
  tenantId       Int           @default(0) @map("tenant_id") @db.UnsignedInt
  tenant         tenants       @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: NoAction, map: "fk_announcement_comments_tenant")

  @@index([announcementId], map: "fk_ann_comment_ann")
  @@index([userId], map: "fk_ann_comment_user")
  @@index([tenantId], map: "idx_announcement_comments_tenant")
}

model announcements {
  id                                                   Int                     @id @default(autoincrement()) @db.UnsignedInt
  title                                                String                  @db.VarChar(200)
  body                                                 String                  @db.LongText
  cityId                                               Int?                    @map("city_id") @db.UnsignedInt
  status                                               announcements_status    @default(draft)
  publishedAt                                          DateTime?               @map("published_at") @db.DateTime(0)
  createdBy                                            Int                     @map("created_by") @db.UnsignedInt
  createdAt                                            DateTime                @default(now()) @map("created_at") @db.DateTime(0)
  updatedAt                                            DateTime                @default(now()) @map("updated_at") @db.DateTime(0)
  comments                                             announcement_comments[]
  author                                               users                   @relation("announcements_created_byTousers", fields: [createdBy], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_ann_author")
  city                                                 cities?                 @relation(fields: [cityId], references: [id], onUpdate: NoAction, map: "fk_ann_city")
  users_users_last_seen_announcement_idToannouncements users[]                 @relation("users_last_seen_announcement_idToannouncements")
  tenantId                                             Int                     @default(0) @map("tenant_id") @db.UnsignedInt
  tenant                                               tenants                 @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: NoAction, map: "fk_announcements_tenant")

  @@index([createdBy], map: "fk_ann_author")
  @@index([cityId], map: "fk_ann_city")
  @@index([tenantId], map: "idx_announcements_tenant")
}

model app_config {
  id          Int      @id @default(autoincrement()) @db.UnsignedInt
  /// Unique per tenant, not globally (REQ-TENANT-01.4). Runtime config is the
  /// half of the old env-var surface that becomes per-community -- branding,
  /// feature flags, terminology -- so two communities must be able to hold the
  /// same key with different values.
  configKey   String   @map("config_key") @db.VarChar(100)
  configValue String   @map("config_value") @db.Text
  description String?  @db.VarChar(500)
  updatedBy   Int?     @map("updated_by") @db.UnsignedInt
  updatedAt   DateTime @default(now()) @map("updated_at") @db.DateTime(0)
  tenantId    Int      @default(0) @map("tenant_id") @db.UnsignedInt
  tenant      tenants  @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: NoAction, map: "fk_app_config_tenant")

  @@unique([tenantId, configKey], map: "uq_config_key")
  @@index([tenantId], map: "idx_app_config_tenant")
}

/// Per-community credentials, encrypted at rest (v2-7).
///
/// Deliberately a separate table from `app_config` rather than a flag on it,
/// for one reason that outweighs the duplication: `app_config` rows are served
/// to unauthenticated visitors. The branding payload reads that table, and the
/// public `/config/:key` endpoint reads it too — both are allowlisted today, but
/// the allowlist is the only thing standing between "a new config key" and "a
/// credential in a public response", and an allowlist is a thing people add to.
/// A secret and a theme colour have different audiences; giving them different
/// tables means no future query can confuse them.
///
/// `secret_value` always holds a `secret-cipher.ts` envelope, never plaintext —
/// the encryption extension puts it there and takes it away again, so a service
/// reading this model sees the plaintext and a database dump does not contain
/// it. Because the cipher is randomised, this column can never be filtered,
/// ordered or joined on; look a secret up by `secret_key` and compare in
/// application code.
model tenant_secrets {
  id          Int      @id @default(autoincrement()) @db.UnsignedInt
  /// The name of the setting, e.g. `geocoding_api_key`. The set that means
  /// anything is declared in `tenant-secret-keys.ts`; a row with any other key
  /// is inert rather than rejected, so a downgrade does not lose data.
  secretKey   String   @map("secret_key") @db.VarChar(100)
  /// Ciphertext. Text rather than VarChar because an envelope is roughly a
  /// third longer than its plaintext plus a 40-byte header, and the plaintext
  /// here is somebody else's API key whose length we do not get to choose.
  secretValue String   @map("secret_value") @db.Text
  updatedBy   Int?     @map("updated_by") @db.UnsignedInt
  updatedAt   DateTime @default(now()) @map("updated_at") @db.DateTime(0)
  tenantId    Int      @default(0) @map("tenant_id") @db.UnsignedInt
  tenant      tenants  @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: NoAction, map: "fk_tenant_secrets_tenant")

  @@unique([tenantId, secretKey], map: "uq_tenant_secret_key")
  @@index([tenantId], map: "idx_tenant_secrets_tenant")
}

model audit_log {
  id         Int      @id @default(autoincrement()) @db.UnsignedInt
  userId     Int?     @map("user_id") @db.UnsignedInt
  action     String   @db.VarChar(100)
  entityType String?  @map("entity_type") @db.VarChar(100)
  entityId   Int?     @map("entity_id") @db.UnsignedInt
  metadata   Json?
  ipAddress  String?  @map("ip_address") @db.VarChar(45)
  createdAt  DateTime @default(now()) @map("created_at") @db.DateTime(0)
  tenantId   Int      @default(0) @map("tenant_id") @db.UnsignedInt
  tenant     tenants  @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: NoAction, map: "fk_audit_log_tenant")

  @@index([action], map: "idx_action")
  @@index([createdAt], map: "idx_created")
  @@index([userId], map: "idx_user")
  @@index([tenantId], map: "idx_audit_log_tenant")
}

model avatar {
  id        Int      @id @default(autoincrement()) @db.UnsignedInt
  path      String   @unique(map: "uq_avatar_path") @db.VarChar(500)
  label     String   @db.VarChar(100)
  sortOrder Int      @default(0) @map("sort_order")
  createdAt DateTime @default(now()) @map("created_at") @db.DateTime(6)
}

model cities {
  id                    Int                     @id @default(autoincrement()) @db.UnsignedInt
  name                  String                  @db.VarChar(100)
  subdomain             String                  @unique(map: "uq_subdomain") @db.VarChar(50)
  isActive              Boolean                 @default(true) @map("is_active")
  createdAt             DateTime                @default(now()) @map("created_at") @db.DateTime(0)
  announcements         announcements[]
  events                events[]
  facebook_group_config facebook_group_config[]
  invites               invites[]
  locations             locations[]
  users                 users[]
}

model content_flags {
  id          Int                        @id @default(autoincrement()) @db.UnsignedInt
  contentType content_flags_content_type @map("content_type")
  contentId   Int                        @map("content_id") @db.UnsignedInt
  reportedBy  Int                        @map("reported_by") @db.UnsignedInt
  reason      String?                    @db.VarChar(500)
  status      content_flags_status       @default(pending)
  reviewedBy  Int?                       @map("reviewed_by") @db.UnsignedInt
  reviewedAt  DateTime?                  @map("reviewed_at") @db.DateTime(0)
  createdAt   DateTime                   @default(now()) @map("created_at") @db.DateTime(0)
  reporter    users                      @relation("content_flags_reported_byTousers", fields: [reportedBy], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_flag_reporter")
  reviewer    users?                     @relation("content_flags_reviewed_byTousers", fields: [reviewedBy], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_flag_reviewer")
  tenantId    Int                        @default(0) @map("tenant_id") @db.UnsignedInt
  tenant      tenants                    @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: NoAction, map: "fk_content_flags_tenant")

  @@unique([contentType, contentId, reportedBy], map: "uq_flag")
  @@index([reportedBy], map: "fk_flag_reporter")
  @@index([reviewedBy], map: "fk_flag_reviewer")
  @@index([tenantId], map: "idx_content_flags_tenant")
}

model content_reports {
  id          Int                          @id @default(autoincrement()) @db.UnsignedInt
  reporterId  Int                          @map("reporter_id") @db.UnsignedInt
  contentType content_reports_content_type @map("content_type")
  contentId   Int                          @map("content_id") @db.UnsignedInt
  reason      String?                      @db.VarChar(500)
  status      content_reports_status       @default(pending)
  reviewedBy  Int?                         @map("reviewed_by") @db.UnsignedInt
  reviewedAt  DateTime?                    @map("reviewed_at") @db.DateTime(0)
  createdAt   DateTime                     @default(now()) @map("created_at") @db.DateTime(0)
  reporter    users                        @relation("content_reports_reporter_idTousers", fields: [reporterId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "FK_report_reporter")
  reviewer    users?                       @relation("content_reports_reviewed_byTousers", fields: [reviewedBy], references: [id], onUpdate: NoAction, map: "FK_report_reviewer")
  tenantId    Int                          @default(0) @map("tenant_id") @db.UnsignedInt
  tenant      tenants                      @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: NoAction, map: "fk_content_reports_tenant")

  @@unique([reporterId, contentType, contentId], map: "UQ_report_per_member")
  @@index([reviewedBy], map: "FK_report_reviewer")
  @@index([status], map: "IDX_report_status")
  @@index([tenantId], map: "idx_content_reports_tenant")
}

model custom_icons {
  id        Int      @id @default(autoincrement()) @db.UnsignedInt
  name      String   @db.VarChar(100)
  imagePath String   @map("image_path") @db.VarChar(500)
  createdBy Int?     @map("created_by") @db.UnsignedInt
  createdAt DateTime @default(now()) @map("created_at") @db.DateTime(0)
  users     users?   @relation(fields: [createdBy], references: [id], onUpdate: NoAction, map: "fk_custom_icons_created_by")
  tenantId  Int      @default(0) @map("tenant_id") @db.UnsignedInt
  tenant    tenants  @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: NoAction, map: "fk_custom_icons_tenant")

  @@index([createdBy], map: "fk_custom_icons_created_by")
  @@index([tenantId], map: "idx_custom_icons_tenant")
}

/// One row per community (v2-9). It was a singleton looked up by `id: 1` until
/// then, which meant one Brevo key, one daily counter and one From identity for
/// every community on the deployment -- and any community's admin able to
/// rewrite all three.
model email_provider_config {
  id                        Int      @id @default(autoincrement()) @db.UnsignedInt
  brevoEnabled              Boolean  @default(true) @map("brevo_enabled")
  resendOverflowEnabled     Boolean  @default(false) @map("resend_overflow_enabled")
  brevoDailyLimit           Int      @default(300) @map("brevo_daily_limit")
  resendDailyLimit          Int      @default(1000) @map("resend_daily_limit")
  brevoSentToday            Int      @default(0) @map("brevo_sent_today")
  resendSentToday           Int      @default(0) @map("resend_sent_today")
  brevoApiKey               String?  @map("brevo_api_key") @db.VarChar(500)
  brevoFromEmail            String?  @map("brevo_from_email") @db.VarChar(255)
  brevoFromName             String?  @map("brevo_from_name") @db.VarChar(200)
  resendApiKey              String?  @map("resend_api_key") @db.VarChar(500)
  resendFromEmail           String?  @map("resend_from_email") @db.VarChar(255)
  resendFromName            String?  @map("resend_from_name") @db.VarChar(200)
  tmplInvite                Int?     @map("tmpl_invite") @db.UnsignedInt
  tmplSecurityAlert         Int?     @map("tmpl_security_alert") @db.UnsignedInt
  tmplEventPublished        Int?     @map("tmpl_event_published") @db.UnsignedInt
  tmplRsvpConfirmation      Int?     @map("tmpl_rsvp_confirmation") @db.UnsignedInt
  tmplEventReminder         Int?     @map("tmpl_event_reminder") @db.UnsignedInt
  tmplAccountDeletion       Int?     @map("tmpl_account_deletion") @db.UnsignedInt
  tmplReengagement60        Int?     @map("tmpl_reengagement_60") @db.UnsignedInt
  tmplReengagement90        Int?     @map("tmpl_reengagement_90") @db.UnsignedInt
  tmplGuestRsvpConfirmation Int?     @map("tmpl_guest_rsvp_confirmation") @db.UnsignedInt
  tmplEmailVerification     Int?     @map("tmpl_email_verification") @db.UnsignedInt
  tmplPasswordReset         Int?     @map("tmpl_password_reset") @db.UnsignedInt
  tmplProviderDisconnected  Int?     @map("tmpl_provider_disconnected") @db.UnsignedInt
  tmplAccountDeleted        Int?     @map("tmpl_account_deleted") @db.UnsignedInt
  lastResetDate             DateTime @map("last_reset_date") @db.Date
  updatedAt                 DateTime @default(now()) @map("updated_at") @db.DateTime(0)
  /// Authenticates Brevo's deliverability callbacks for THIS community's Brevo
  /// account. Encrypted like the keys beside it, so it cannot be looked up by
  /// value -- the tenant is resolved from the Host header first and the token
  /// compared after decryption.
  webhookSecret             String?  @map("webhook_secret") @db.VarChar(500)
  /// Brevo's id for the webhook this deployment registered, so re-registering
  /// updates it rather than adding a duplicate (an account is capped at 40).
  /// Stored as a string although Brevo returns a number: a BIGINT column comes
  /// back from Prisma as a JS BigInt, which `JSON.stringify` throws on, and
  /// nothing here does arithmetic on it.
  webhookId                 String?  @map("webhook_id") @db.VarChar(64)
  tenantId                  Int      @default(0) @map("tenant_id") @db.UnsignedInt
  tenant                    tenants  @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: NoAction, map: "fk_email_provider_config_tenant")

  @@unique([tenantId], map: "uq_email_provider_config_tenant")
}

model email_queue {
  id             Int                   @id @default(autoincrement()) @db.UnsignedInt
  toEmail        String                @map("to_email") @db.VarChar(255)
  toName         String?               @map("to_name") @db.VarChar(200)
  subject        String                @db.VarChar(500)
  templateId     String?               @map("template_id") @db.VarChar(100)
  templateParams Json?                 @map("template_params")
  htmlBody       String?               @map("html_body") @db.LongText
  textBody       String?               @map("text_body") @db.Text
  priority       Int                   @default(5) @db.TinyInt
  status         email_queue_status    @default(pending)
  provider       email_queue_provider?
  attempts       Int                   @default(0)
  lastAttemptAt  DateTime?             @map("last_attempt_at") @db.DateTime(0)
  errorMessage   String?               @map("error_message") @db.Text
  brevoStatus    String?               @map("brevo_status") @db.VarChar(100)
  sendAfter      DateTime?             @map("send_after") @db.DateTime(0)
  createdAt      DateTime              @default(now()) @map("created_at") @db.DateTime(0)
  sentAt         DateTime?             @map("sent_at") @db.DateTime(0)
  tenantId       Int                   @default(0) @map("tenant_id") @db.UnsignedInt
  tenant         tenants               @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: NoAction, map: "fk_email_queue_tenant")

  @@index([sendAfter], map: "idx_send_after")
  @@index([status, priority], map: "idx_status_priority")
  @@index([tenantId], map: "idx_email_queue_tenant")
}

model email_suppressions {
  id        Int                       @id @default(autoincrement()) @db.UnsignedInt
  emailHash String                    @unique(map: "uq_email_hash") @map("email_hash") @db.VarChar(255)
  reason    email_suppressions_reason
  createdAt DateTime                  @default(now()) @map("created_at") @db.DateTime(0)
}

model event_comment_replies {
  id        Int            @id @default(autoincrement()) @db.UnsignedInt
  commentId Int            @map("comment_id") @db.UnsignedInt
  memberId  Int            @map("member_id") @db.UnsignedInt
  body      String         @db.Text
  editedAt  DateTime?      @map("edited_at") @db.DateTime(0)
  createdAt DateTime       @default(now()) @map("created_at") @db.DateTime(0)
  deletedAt DateTime?      @map("deleted_at") @db.DateTime(0)
  comment   event_comments @relation(fields: [commentId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_ecr_comment")
  member    users          @relation(fields: [memberId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_ecr_member")
  tenantId  Int            @default(0) @map("tenant_id") @db.UnsignedInt
  tenant    tenants        @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: NoAction, map: "fk_event_comment_replies_tenant")

  @@index([commentId], map: "idx_ecr_comment")
  @@index([memberId], map: "idx_ecr_member")
  @@index([tenantId], map: "idx_event_comment_replies_tenant")
}

model event_comments {
  id        Int                     @id @default(autoincrement()) @db.UnsignedInt
  eventId   Int                     @map("event_id") @db.UnsignedInt
  memberId  Int                     @map("member_id") @db.UnsignedInt
  body      String                  @db.Text
  editedAt  DateTime?               @map("edited_at") @db.DateTime(0)
  createdAt DateTime                @default(now()) @map("created_at") @db.DateTime(0)
  deletedAt DateTime?               @map("deleted_at") @db.DateTime(0)
  replies   event_comment_replies[]
  event     events                  @relation(fields: [eventId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_ec_event")
  member    users                   @relation(fields: [memberId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_ec_member")
  tenantId  Int                     @default(0) @map("tenant_id") @db.UnsignedInt
  tenant    tenants                 @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: NoAction, map: "fk_event_comments_tenant")

  @@index([eventId], map: "idx_ec_event")
  @@index([memberId], map: "idx_ec_member")
  @@index([tenantId], map: "idx_event_comments_tenant")
}

model event_guest_links {
  id             Int                             @id @default(autoincrement()) @db.UnsignedInt
  eventId        Int                             @map("event_id") @db.UnsignedInt
  createdById    Int?                            @map("created_by") @db.UnsignedInt
  memberRsvpId   Int?                            @map("member_rsvp_id") @db.UnsignedInt
  deliveryType   event_guest_links_delivery_type @default(shareable) @map("delivery_type")
  source         event_guest_links_source        @default(member)
  recipientName  String?                         @map("recipient_name") @db.VarChar(200)
  recipientEmail String?                         @map("recipient_email") @db.VarChar(255)
  token          String                          @unique(map: "uq_token") @db.VarChar(100)
  expiresAt      DateTime                        @map("expires_at") @db.DateTime(0)
  usedAt         DateTime?                       @map("used_at") @db.DateTime(0)
  cancelledAt    DateTime?                       @map("cancelled_at") @db.DateTime(0)
  attended       Boolean?
  createdAt      DateTime                        @default(now()) @map("created_at") @db.DateTime(0)
  event          events                          @relation(fields: [eventId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_guestlink_event")
  memberRsvp     event_rsvps?                    @relation(fields: [memberRsvpId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_guestlink_rsvp")
  createdBy      users?                          @relation(fields: [createdById], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_guestlink_user")
  tenantId       Int                             @default(0) @map("tenant_id") @db.UnsignedInt
  tenant         tenants                         @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: NoAction, map: "fk_event_guest_links_tenant")

  @@index([createdById], map: "idx_created_by")
  @@index([eventId], map: "idx_event")
  @@index([memberRsvpId], map: "idx_rsvp")
  @@index([tenantId], map: "idx_event_guest_links_tenant")
