// Single source of truth for the CommunityEvents data model (REQ-TENANT-01.3).
//
// Generated by `prisma db pull` against a local database built by running the
// inherited v1 TypeORM migrations, so it describes the v1 schema exactly as it
// exists today, not a redesign. Tenant scoping (tenant_id columns, the tenants
// table) arrives in v2-3 and later; do not add it here ahead of those items.
//
// Model and field names are the raw database names (snake_case, plural) rather
// than idiomatic Prisma ones. That is deliberate for v2-1: renaming models and
// rewriting every call site in the same change would make the TypeORM removal
// impossible to review. Renames, if wanted, are a separate follow-up via @@map.
//
// TypeORM's own `migrations` bookkeeping table is deliberately absent. It came
// back from introspection because it existed in the database that was pulled,
// but v2 starts from a blank database with the schema owned by a single Prisma
// migration, so there is no TypeORM history to record and Prisma tracks its
// own state in `_prisma_migrations`.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
}

model achievements {
  id                  Int                         @id @default(autoincrement()) @db.UnsignedInt
  key                 String                      @unique(map: "uq_achievements_key") @db.VarChar(64)
  name                String                      @db.VarChar(120)
  description         String                      @db.VarChar(500)
  icon                String                      @default("emoji_events") @db.VarChar(255)
  image_path          String?                     @db.VarChar(500)
  progress_type       achievements_progress_type?
  progress_target     Int?                        @db.UnsignedInt
  event_id            Int?                        @db.UnsignedInt
  points              Int                         @default(0) @db.TinyInt
  title               String?                     @db.VarChar(100)
  is_secret           Boolean                     @default(false)
  created_at          DateTime                    @default(now()) @db.DateTime(0)
  events              events?                     @relation(fields: [event_id], references: [id], onUpdate: NoAction, map: "fk_achievements_event")
  member_achievements member_achievements[]

  @@index([event_id], map: "fk_achievements_event")
}

model announcement_comments {
  id              Int           @id @default(autoincrement()) @db.UnsignedInt
  announcement_id Int           @db.UnsignedInt
  user_id         Int           @db.UnsignedInt
  body            String        @db.Text
  edited_at       DateTime?     @db.DateTime(0)
  created_at      DateTime      @default(now()) @db.DateTime(0)
  deleted_at      DateTime?     @db.DateTime(0)
  announcements   announcements @relation(fields: [announcement_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_ann_comment_ann")
  users           users         @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_ann_comment_user")

  @@index([announcement_id], map: "fk_ann_comment_ann")
  @@index([user_id], map: "fk_ann_comment_user")
}

model announcements {
  id                                                   Int                     @id @default(autoincrement()) @db.UnsignedInt
  title                                                String                  @db.VarChar(200)
  body                                                 String                  @db.LongText
  city_id                                              Int?                    @db.UnsignedInt
  status                                               announcements_status    @default(draft)
  published_at                                         DateTime?               @db.DateTime(0)
  created_by                                           Int                     @db.UnsignedInt
  created_at                                           DateTime                @default(now()) @db.DateTime(0)
  updated_at                                           DateTime                @default(now()) @db.DateTime(0)
  announcement_comments                                announcement_comments[]
  users_announcements_created_byTousers                users                   @relation("announcements_created_byTousers", fields: [created_by], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_ann_author")
  cities                                               cities?                 @relation(fields: [city_id], references: [id], onUpdate: NoAction, map: "fk_ann_city")
  users_users_last_seen_announcement_idToannouncements users[]                 @relation("users_last_seen_announcement_idToannouncements")

  @@index([created_by], map: "fk_ann_author")
  @@index([city_id], map: "fk_ann_city")
}

model app_config {
  id           Int      @id @default(autoincrement()) @db.UnsignedInt
  config_key   String   @unique(map: "uq_config_key") @db.VarChar(100)
  config_value String   @db.Text
  description  String?  @db.VarChar(500)
  updated_by   Int?     @db.UnsignedInt
  updated_at   DateTime @default(now()) @db.DateTime(0)
}

model audit_log {
  id          Int      @id @default(autoincrement()) @db.UnsignedInt
  user_id     Int?     @db.UnsignedInt
  action      String   @db.VarChar(100)
  entity_type String?  @db.VarChar(100)
  entity_id   Int?     @db.UnsignedInt
  metadata    Json?
  ip_address  String?  @db.VarChar(45)
  created_at  DateTime @default(now()) @db.DateTime(0)

  @@index([action], map: "idx_action")
  @@index([created_at], map: "idx_created")
  @@index([user_id], map: "idx_user")
}

model avatar {
  id         Int      @id @default(autoincrement()) @db.UnsignedInt
  path       String   @unique(map: "uq_avatar_path") @db.VarChar(500)
  label      String   @db.VarChar(100)
  sort_order Int      @default(0)
  created_at DateTime @default(now()) @db.DateTime(6)
}

model cities {
  id                    Int                     @id @default(autoincrement()) @db.UnsignedInt
  name                  String                  @db.VarChar(100)
  subdomain             String                  @unique(map: "uq_subdomain") @db.VarChar(50)
  is_active             Boolean                 @default(true)
  created_at            DateTime                @default(now()) @db.DateTime(0)
  announcements         announcements[]
  events                events[]
  facebook_group_config facebook_group_config[]
  invites               invites[]
  locations             locations[]
  users                 users[]
}

model content_flags {
  id                                     Int                        @id @default(autoincrement()) @db.UnsignedInt
  content_type                           content_flags_content_type
  content_id                             Int                        @db.UnsignedInt
  reported_by                            Int                        @db.UnsignedInt
  reason                                 String?                    @db.VarChar(500)
  status                                 content_flags_status       @default(pending)
  reviewed_by                            Int?                       @db.UnsignedInt
  reviewed_at                            DateTime?                  @db.DateTime(0)
  created_at                             DateTime                   @default(now()) @db.DateTime(0)
  users_content_flags_reported_byTousers users                      @relation("content_flags_reported_byTousers", fields: [reported_by], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_flag_reporter")
  users_content_flags_reviewed_byTousers users?                     @relation("content_flags_reviewed_byTousers", fields: [reviewed_by], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_flag_reviewer")

  @@unique([content_type, content_id, reported_by], map: "uq_flag")
  @@index([reported_by], map: "fk_flag_reporter")
  @@index([reviewed_by], map: "fk_flag_reviewer")
}

model content_reports {
  id                                       Int                          @id @default(autoincrement()) @db.UnsignedInt
  reporter_id                              Int                          @db.UnsignedInt
  content_type                             content_reports_content_type
  content_id                               Int                          @db.UnsignedInt
  reason                                   String?                      @db.VarChar(500)
  status                                   content_reports_status       @default(pending)
  reviewed_by                              Int?                         @db.UnsignedInt
  reviewed_at                              DateTime?                    @db.DateTime(0)
  created_at                               DateTime                     @default(now()) @db.DateTime(0)
  users_content_reports_reporter_idTousers users                        @relation("content_reports_reporter_idTousers", fields: [reporter_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "FK_report_reporter")
  users_content_reports_reviewed_byTousers users?                       @relation("content_reports_reviewed_byTousers", fields: [reviewed_by], references: [id], onUpdate: NoAction, map: "FK_report_reviewer")

  @@unique([reporter_id, content_type, content_id], map: "UQ_report_per_member")
  @@index([reviewed_by], map: "FK_report_reviewer")
  @@index([status], map: "IDX_report_status")
}

model custom_icons {
  id         Int      @id @default(autoincrement()) @db.UnsignedInt
  name       String   @db.VarChar(100)
  image_path String   @db.VarChar(500)
  created_by Int?     @db.UnsignedInt
  created_at DateTime @default(now()) @db.DateTime(0)
  users      users?   @relation(fields: [created_by], references: [id], onUpdate: NoAction, map: "fk_custom_icons_created_by")

  @@index([created_by], map: "fk_custom_icons_created_by")
}

model email_provider_config {
  id                           Int      @id @default(autoincrement()) @db.UnsignedInt
  brevo_enabled                Boolean  @default(true)
  resend_overflow_enabled      Boolean  @default(false)
  brevo_daily_limit            Int      @default(300)
  resend_daily_limit           Int      @default(1000)
  brevo_sent_today             Int      @default(0)
  resend_sent_today            Int      @default(0)
  brevo_api_key                String?  @db.VarChar(500)
  brevo_from_email             String?  @db.VarChar(255)
  brevo_from_name              String?  @db.VarChar(200)
  resend_api_key               String?  @db.VarChar(500)
  resend_from_email            String?  @db.VarChar(255)
  resend_from_name             String?  @db.VarChar(200)
  tmpl_invite                  Int?     @db.UnsignedInt
  tmpl_security_alert          Int?     @db.UnsignedInt
  tmpl_event_published         Int?     @db.UnsignedInt
  tmpl_rsvp_confirmation       Int?     @db.UnsignedInt
  tmpl_event_reminder          Int?     @db.UnsignedInt
  tmpl_account_deletion        Int?     @db.UnsignedInt
  tmpl_reengagement_60         Int?     @db.UnsignedInt
  tmpl_reengagement_90         Int?     @db.UnsignedInt
  tmpl_guest_rsvp_confirmation Int?     @db.UnsignedInt
  tmpl_email_verification      Int?     @db.UnsignedInt
  tmpl_password_reset          Int?     @db.UnsignedInt
  tmpl_provider_disconnected   Int?     @db.UnsignedInt
  tmpl_account_deleted         Int?     @db.UnsignedInt
  last_reset_date              DateTime @db.Date
  updated_at                   DateTime @default(now()) @db.DateTime(0)
}

model email_queue {
  id              Int                   @id @default(autoincrement()) @db.UnsignedInt
  to_email        String                @db.VarChar(255)
  to_name         String?               @db.VarChar(200)
  subject         String                @db.VarChar(500)
  template_id     String?               @db.VarChar(100)
  template_params Json?
  html_body       String?               @db.LongText
  text_body       String?               @db.Text
  priority        Int                   @default(5) @db.TinyInt
  status          email_queue_status    @default(pending)
  provider        email_queue_provider?
  attempts        Int                   @default(0)
  last_attempt_at DateTime?             @db.DateTime(0)
  error_message   String?               @db.Text
  brevo_status    String?               @db.VarChar(100)
  send_after      DateTime?             @db.DateTime(0)
  created_at      DateTime              @default(now()) @db.DateTime(0)
  sent_at         DateTime?             @db.DateTime(0)

  @@index([send_after], map: "idx_send_after")
  @@index([status, priority], map: "idx_status_priority")
}

model email_suppressions {
  id         Int                       @id @default(autoincrement()) @db.UnsignedInt
  email_hash String                    @unique(map: "uq_email_hash") @db.VarChar(255)
  reason     email_suppressions_reason
  created_at DateTime                  @default(now()) @db.DateTime(0)
}

model event_comment_replies {
  id             Int            @id @default(autoincrement()) @db.UnsignedInt
  comment_id     Int            @db.UnsignedInt
  member_id      Int            @db.UnsignedInt
  body           String         @db.Text
  edited_at      DateTime?      @db.DateTime(0)
  created_at     DateTime       @default(now()) @db.DateTime(0)
  deleted_at     DateTime?      @db.DateTime(0)
  event_comments event_comments @relation(fields: [comment_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_ecr_comment")
  users          users          @relation(fields: [member_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_ecr_member")

  @@index([comment_id], map: "idx_ecr_comment")
  @@index([member_id], map: "idx_ecr_member")
}

model event_comments {
  id                    Int                     @id @default(autoincrement()) @db.UnsignedInt
  event_id              Int                     @db.UnsignedInt
  member_id             Int                     @db.UnsignedInt
  body                  String                  @db.Text
  edited_at             DateTime?               @db.DateTime(0)
  created_at            DateTime                @default(now()) @db.DateTime(0)
  deleted_at            DateTime?               @db.DateTime(0)
  event_comment_replies event_comment_replies[]
  events                events                  @relation(fields: [event_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_ec_event")
  users                 users                   @relation(fields: [member_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_ec_member")

  @@index([event_id], map: "idx_ec_event")
  @@index([member_id], map: "idx_ec_member")
}

model event_guest_links {
  id              Int                             @id @default(autoincrement()) @db.UnsignedInt
  event_id        Int                             @db.UnsignedInt
  created_by      Int?                            @db.UnsignedInt
  member_rsvp_id  Int?                            @db.UnsignedInt
  delivery_type   event_guest_links_delivery_type @default(shareable)
  source          event_guest_links_source        @default(member)
  recipient_name  String?                         @db.VarChar(200)
  recipient_email String?                         @db.VarChar(255)
  token           String                          @unique(map: "uq_token") @db.VarChar(100)
  expires_at      DateTime                        @db.DateTime(0)
  used_at         DateTime?                       @db.DateTime(0)
  cancelled_at    DateTime?                       @db.DateTime(0)
  attended        Boolean?
  created_at      DateTime                        @default(now()) @db.DateTime(0)
  events          events                          @relation(fields: [event_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_guestlink_event")
  event_rsvps     event_rsvps?                    @relation(fields: [member_rsvp_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_guestlink_rsvp")
  users           users?                          @relation(fields: [created_by], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_guestlink_user")

  @@index([created_by], map: "idx_created_by")
  @@index([event_id], map: "idx_event")
  @@index([member_rsvp_id], map: "idx_rsvp")
}

model event_rsvps {
  id                Int                 @id @default(autoincrement()) @db.UnsignedInt
  event_id          Int                 @db.UnsignedInt
  user_id           Int                 @db.UnsignedInt
  additional_guests Int                 @default(0) @db.UnsignedTinyInt
  guest_names       Json?
  bringing_item     String?             @db.VarChar(200)
  created_at        DateTime            @default(now()) @db.DateTime(0)
  updated_at        DateTime            @default(now()) @db.DateTime(0)
  status            event_rsvps_status  @default(going)
  attended          Boolean?
  is_walkin         Boolean             @default(false)
  from_other_city   Boolean             @default(false)
  event_guest_links event_guest_links[]
  events            events              @relation(fields: [event_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_rsvp_event")
  users             users               @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_rsvp_user")

  @@unique([event_id, user_id], map: "uq_event_member")
  @@index([event_id], map: "idx_event")
  @@index([user_id], map: "idx_user")
}

model events {
  id                                          Int                 @id @default(autoincrement()) @db.UnsignedInt
  city_id                                     Int                 @db.UnsignedInt
  location_id                                 Int?                @db.UnsignedInt
  location_name                               String              @db.VarChar(255)
  location_address                            String              @db.VarChar(500)
  location_lat                                Decimal?            @db.Decimal(10, 7)
  location_lng                                Decimal?            @db.Decimal(10, 7)
  title                                       String              @db.VarChar(255)
  description                                 String?             @db.Text
  additional_info                             String?             @db.Text
  event_date                                  DateTime            @db.Date
  event_time                                  DateTime            @db.Time(0)
  status                                      events_status       @default(draft)
  published_at                                DateTime?           @db.DateTime(0)
  cancelled_at                                DateTime?           @db.DateTime(0)
  cancelled_reason                            String?             @db.Text
  facebook_share_text                         String?             @db.Text
  reservation_assignee_id                     Int?                @db.UnsignedInt
  reservation_contact_name                    String?             @db.VarChar(150)
  reservation_contact_email                   String?             @db.VarChar(255)
  reservation_confirmed                       Boolean             @default(false)
  reservation_confirmed_by                    String?             @db.VarChar(255)
  reservation_confirmed_at                    DateTime?           @db.DateTime(0)
  reservation_confirmed_note                  String?             @db.VarChar(500)
  reservation_seats_email_sent                Boolean             @default(false)
  reservation_confirm_token                   String?             @unique(map: "uq_events_reservation_token") @db.VarChar(64)
  created_by                                  Int                 @db.UnsignedInt
  created_at                                  DateTime            @default(now()) @db.DateTime(0)
  updated_at                                  DateTime            @default(now()) @db.DateTime(0)
  is_secret                                   Boolean             @default(false)
  achievements                                achievements[]
  event_comments                              event_comments[]
  event_guest_links                           event_guest_links[]
  event_rsvps                                 event_rsvps[]
  cities                                      cities              @relation(fields: [city_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_event_city")
  users_events_created_byTousers              users               @relation("events_created_byTousers", fields: [created_by], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_event_created_by")
  locations                                   locations?          @relation(fields: [location_id], references: [id], onUpdate: NoAction, map: "fk_event_location")
  users_events_reservation_assignee_idTousers users?              @relation("events_reservation_assignee_idTousers", fields: [reservation_assignee_id], references: [id], onUpdate: NoAction, map: "fk_events_reservation_assignee")
  location_ratings                            location_ratings[]

  @@index([created_by], map: "fk_event_created_by")
  @@index([location_id], map: "fk_event_location")
  @@index([reservation_assignee_id], map: "fk_events_reservation_assignee")
  @@index([city_id, event_date], map: "idx_city_date")
  @@index([status], map: "idx_status")
}

model facebook_deletion_requests {
  id                  Int                               @id @default(autoincrement()) @db.UnsignedInt
  facebook_user_id    String                            @db.VarChar(255)
  confirmation_code   String                            @unique(map: "UQ_fb_deletion_code") @db.VarChar(100)
  dinnerbears_user_id Int?                              @db.UnsignedInt
  status              facebook_deletion_requests_status @default(pending)
  requested_at        DateTime                          @default(now()) @db.DateTime(0)
  completed_at        DateTime?                         @db.DateTime(0)

  @@index([facebook_user_id], map: "IDX_fb_deletion_user_id")
}

model facebook_group_config {
  id         Int                              @id @default(autoincrement()) @db.UnsignedInt
  name       String                           @db.VarChar(255)
  url        String                           @db.VarChar(500)
  group_id   String?                          @db.VarChar(50)
  city_id    Int?                             @db.UnsignedInt
  group_role facebook_group_config_group_role @default(primary)
  is_active  Boolean                          @default(true)
  created_at DateTime                         @default(now()) @db.DateTime(0)
  updated_at DateTime                         @default(now()) @db.DateTime(0)
  cities     cities?                          @relation(fields: [city_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_fbgroup_city")
  invites    invites[]

  @@index([city_id], map: "fk_fbgroup_city")
}

model feedback {
  id               Int                @id @default(autoincrement()) @db.UnsignedInt
  user_id          Int                @db.UnsignedInt
  title            String?            @db.VarChar(200)
  category         feedback_category
  body             String             @db.Text
  status           feedback_status    @default(open)
  admin_note       String?            @db.Text
  release_note     String?            @db.VarChar(500)
  is_private       Boolean            @default(false)
  upvote_count     Int                @default(0) @db.UnsignedInt
  seen_at          DateTime?          @db.DateTime(0)
  resolved_at      DateTime?          @db.DateTime(0)
  created_at       DateTime           @default(now()) @db.DateTime(0)
  updated_at       DateTime           @default(now()) @db.DateTime(0)
  users            users              @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_feedback_user")
  feedback_notes   feedback_notes[]
  feedback_upvotes feedback_upvotes[]
  release_feedback release_feedback[]

  @@index([user_id], map: "fk_feedback_user")
  @@index([category], map: "idx_feedback_category")
  @@index([created_at], map: "idx_feedback_created")
  @@index([status], map: "idx_feedback_status")
}

model feedback_notes {
  id            Int      @id @default(autoincrement()) @db.UnsignedInt
  feedback_id   Int      @db.UnsignedInt
  author_id     Int      @db.UnsignedInt
  content       String   @db.Text
  is_admin_only Boolean  @default(false)
  created_at    DateTime @default(now()) @db.DateTime(0)
  users         users    @relation(fields: [author_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_fnote_author")
  feedback      feedback @relation(fields: [feedback_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_fnote_feedback")

  @@index([author_id], map: "fk_fnote_author")
  @@index([feedback_id], map: "idx_fnote_feedback")
}

model feedback_upvotes {
  id          Int      @id @default(autoincrement()) @db.UnsignedInt
  feedback_id Int      @db.UnsignedInt
  member_id   Int      @db.UnsignedInt
  created_at  DateTime @default(now()) @db.DateTime(0)
  feedback    feedback @relation(fields: [feedback_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_fup_feedback")
  users       users    @relation(fields: [member_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_fup_member")

  @@unique([feedback_id, member_id], map: "uq_feedback_member")
  @@index([member_id], map: "fk_fup_member")
}

model invites {
  id                               Int                    @id @default(autoincrement()) @db.UnsignedInt
  token                            String                 @unique(map: "uq_token") @db.VarChar(100)
  type                             invites_type
  created_by                       Int                    @db.UnsignedInt
  city_id                          Int?                   @db.UnsignedInt
  event_id                         Int?                   @db.UnsignedInt
  facebook_group_id                Int?                   @db.UnsignedInt
  bound_to_email                   String?                @db.VarChar(255)
  bound_to_name                    String?                @db.VarChar(200)
  redeemed_by                      Int?                   @db.UnsignedInt
  redeemed_at                      DateTime?              @db.DateTime(0)
  guest_rsvp_id                    Int?                   @db.UnsignedInt
  expires_at                       DateTime               @db.DateTime(0)
  is_revoked                       Boolean                @default(false)
  max_uses                         Int?                   @default(1)
  use_count                        Int                    @default(0)
  created_at                       DateTime               @default(now()) @db.DateTime(0)
  invite_flavor                    invites_invite_flavor?
  cities                           cities?                @relation(fields: [city_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_invite_city")
  users_invites_created_byTousers  users                  @relation("invites_created_byTousers", fields: [created_by], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_invite_creator")
  facebook_group_config            facebook_group_config? @relation(fields: [facebook_group_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_invite_fbgroup")
  users_invites_redeemed_byTousers users?                 @relation("invites_redeemed_byTousers", fields: [redeemed_by], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_invite_redeemed_by")
  users_users_invite_idToinvites   users[]                @relation("users_invite_idToinvites")

  @@index([city_id], map: "fk_invite_city")
  @@index([redeemed_by], map: "fk_invite_redeemed_by")
  @@index([created_by], map: "idx_created_by")
  @@index([facebook_group_id], map: "idx_facebook_group")
  @@index([token], map: "idx_token")
