/// This model or at least one of its fields has comments in the database, and requires an additional setup for migrations: Read more: https://pris.ly/d/database-comments
model tenants {
  id                       Int                        @id @default(autoincrement()) @db.UnsignedInt
  slug                     String                     @unique(map: "uq_tenant_slug") @db.VarChar(50)
  /// Stored bare and lower-cased, never with a leading "www." -- `www.<domain>`
  /// and `<domain>` are the same tenant and must never become two rows
  /// (REQ-TENANT-01.1). Resolution strips the prefix before lookup.
  domain                   String                     @unique(map: "uq_tenant_domain") @db.VarChar(255)
  isRoot                   Boolean                    @default(false) @map("is_root")
  /// Enforces "exactly one tenant has is_root = true" in the database rather
  /// than in application code. MySQL has no partial unique index, but it does
  /// allow repeated NULLs in a unique index -- so this column is `true` on the
  /// root tenant and NULL everywhere else, and a second root is rejected by the
  /// engine. It must always be written in the same statement as isRoot; nothing
  /// outside the tenant seed should touch either. A second root tenant would
  /// mean a second system admin, which is why this is a constraint and not a
  /// convention.
  rootMarker               Boolean?                   @unique(map: "uq_tenant_single_root") @map("root_marker")
  status                   tenants_status             @default(active)
  /// Reserved (REQ-TENANT-01.1). Every tenant shares one database today; the
  /// column exists so a future dedicated-database option does not need a
  /// migration on a live table.
  dbMode                   tenants_db_mode            @default(shared) @map("db_mode")
  /// Reserved for REQ-TENANT-01.9, read by no code as of v2-5. NULL -- the
  /// default -- means **that provider is switched off for this tenant**, which
  /// then offers email/password only. There is no platform-wide fallback app:
  /// a community that has not registered its own OAuth app has no relationship
  /// with Google or Meta, and signing its members in through the platform's app
  /// would make the platform the party those users granted consent to.
  ///
  /// (An earlier draft of REQ-TENANT-01.1 described NULL as "uses the
  /// platform's own OAuth apps". That was reversed on 2026-08-14; the columns
  /// are unchanged, their meaning is not.)
  ///
  /// The two *Secret columns are encrypted at rest, which is why they are Text
  /// rather than VarChar -- an envelope is longer than the plaintext it
  /// replaces. v2-7 built that layer and both columns are declared in
  /// `encrypted-columns.ts`, so the Prisma extension encrypts them on write and
  /// decrypts them on read; no service ever handles the ciphertext. Nothing
  /// populates them yet -- v2-8 is what does -- but the guarantee is in place
  /// ahead of the writer rather than owed by it.
  googleClientId           String?                    @map("google_client_id") @db.VarChar(255)
  googleClientSecret       String?                    @map("google_client_secret") @db.Text
  facebookAppId            String?                    @map("facebook_app_id") @db.VarChar(255)
  facebookAppSecret        String?                    @map("facebook_app_secret") @db.Text
  createdAt                DateTime                   @default(now()) @map("created_at") @db.DateTime(0)
  announcement_comments    announcement_comments[]
  announcements            announcements[]
  audit_log                audit_log[]
  content_flags            content_flags[]
  content_reports          content_reports[]
  custom_icons             custom_icons[]
  email_queue              email_queue[]
  event_comment_replies    event_comment_replies[]
  event_comments           event_comments[]
  event_guest_links        event_guest_links[]
  event_rsvps              event_rsvps[]
  events                   events[]
  facebook_group_config    facebook_group_config[]
  feedback                 feedback[]
  feedback_notes           feedback_notes[]
  feedback_upvotes         feedback_upvotes[]
  invites                  invites[]
  location_photos          location_photos[]
  location_ratings         location_ratings[]
  locations                locations[]
  login_sessions           login_sessions[]
  member_achievements      member_achievements[]
  member_points            member_points[]
  notification_preferences notification_preferences[]
  notifications            notifications[]
  oauth_accounts           oauth_accounts[]
  push_subscriptions       push_subscriptions[]
  app_config               app_config[]
  users                    users[]
  tenant_secrets           tenant_secrets[]
  email_provider_config    email_provider_config?

  @@index([status], map: "idx_tenant_status")
}

model users {
  id                                                           Int                        @id @default(autoincrement()) @db.UnsignedInt
  fullName                                                     String                     @map("full_name") @db.VarChar(200)
  email                                                        String                     @db.VarChar(255)
  emailStatus                                                  users_email_status         @default(pending) @map("email_status")
  emailVerifiedAt                                              DateTime?                  @map("email_verified_at") @db.DateTime(0)
  passwordHash                                                 String?                    @map("password_hash") @db.VarChar(255)
  emailVerificationToken                                       String?                    @map("email_verification_token") @db.VarChar(255)
  emailVerificationExpiresAt                                   DateTime?                  @map("email_verification_expires_at") @db.DateTime(0)
  passwordResetToken                                           String?                    @map("password_reset_token") @db.VarChar(255)
  passwordResetExpiresAt                                       DateTime?                  @map("password_reset_expires_at") @db.DateTime(0)
  cityId                                                       Int                        @map("city_id") @db.UnsignedInt
  role                                                         users_role                 @default(member)
  /// Marks a non-human account the deployment created for itself, never a
  /// member who signed up. Every tenant gets exactly one (see bootstrap.ts and
  /// provision-tenant.ts); it cannot be deleted, and it is excluded from the
  /// member directory and the leaderboard the same way admins are.
  ///
  /// A column rather than a check on `role` or on the fixed automation email,
  /// because both of those are things that change: `role` is deliberately
  /// mutable (the root account gets flipped to admin and back for testing), and
  /// the email is branding that v2-9 will rewrite. This is set once at creation
  /// and nothing offers a way to change it.
  isServiceAccount                                             Boolean                    @default(false) @map("is_service_account")
  hasMembership                                                Boolean                    @default(false) @map("has_membership")
  membershipExpiresAt                                          DateTime?                  @map("membership_expires_at") @db.DateTime(0)
  profilePhotoPath                                             String?                    @map("profile_photo_path") @db.VarChar(500)
  status                                                       users_status               @default(active)
  invitedBy                                                    Int?                       @map("invited_by") @db.UnsignedInt
  inviteId                                                     Int?                       @map("invite_id") @db.UnsignedInt
  inviteSource                                                 users_invite_source?       @map("invite_source")
  inviteSourceName                                             String?                    @map("invite_source_name") @db.VarChar(255)
  lastLoginAt                                                  DateTime?                  @map("last_login_at") @db.DateTime(0)
  loginCount                                                   Int                        @default(0) @map("login_count") @db.UnsignedInt
  failedLoginAttempts                                          Int                        @default(0) @map("failed_login_attempts") @db.UnsignedTinyInt
  loginLockedUntil                                             DateTime?                  @map("login_locked_until") @db.DateTime(0)
  lastFailedLoginAt                                            DateTime?                  @map("last_failed_login_at") @db.DateTime(0)
  deletedAt                                                    DateTime?                  @map("deleted_at") @db.DateTime(0)
  hardDeleteAt                                                 DateTime?                  @map("hard_delete_at") @db.DateTime(0)
  createdAt                                                    DateTime                   @default(now()) @map("created_at") @db.DateTime(0)
  updatedAt                                                    DateTime                   @default(now()) @map("updated_at") @db.DateTime(0)
  calendarToken                                                String?                    @unique(map: "calendar_token") @map("calendar_token") @db.VarChar(36)
  calendarCityFilter                                           users_calendar_city_filter @default(all) @map("calendar_city_filter")
  calendarRsvpOnly                                             Boolean                    @default(false) @map("calendar_rsvp_only")
  calendarAutoInvite                                           users_calendar_auto_invite @default(none) @map("calendar_auto_invite")
  selectedTitle                                                String?                    @map("selected_title") @db.VarChar(100)
  qualifyingLoginCount                                         Int                        @default(0) @map("qualifying_login_count") @db.UnsignedInt
  lastQualifyingLoginAt                                        DateTime?                  @map("last_qualifying_login_at") @db.DateTime(0)
  lastSeenReleaseId                                            Int?                       @map("last_seen_release_id") @db.UnsignedInt
  lastSeenAnnouncementId                                       Int?                       @map("last_seen_announcement_id") @db.UnsignedInt
  announcement_comments                                        announcement_comments[]
  announcements_announcements_created_byTousers                announcements[]            @relation("announcements_created_byTousers")
  content_flags_content_flags_reported_byTousers               content_flags[]            @relation("content_flags_reported_byTousers")
  content_flags_content_flags_reviewed_byTousers               content_flags[]            @relation("content_flags_reviewed_byTousers")
  content_reports_content_reports_reporter_idTousers           content_reports[]          @relation("content_reports_reporter_idTousers")
  content_reports_content_reports_reviewed_byTousers           content_reports[]          @relation("content_reports_reviewed_byTousers")
  custom_icons                                                 custom_icons[]
  event_comment_replies                                        event_comment_replies[]
  event_comments                                               event_comments[]
  event_guest_links                                            event_guest_links[]
  event_rsvps                                                  event_rsvps[]
  events_events_created_byTousers                              events[]                   @relation("events_created_byTousers")
  events_events_reservation_assignee_idTousers                 events[]                   @relation("events_reservation_assignee_idTousers")
  feedback                                                     feedback[]
  feedback_notes                                               feedback_notes[]
  feedback_upvotes                                             feedback_upvotes[]
  invites_invites_created_byTousers                            invites[]                  @relation("invites_created_byTousers")
  invites_invites_redeemed_byTousers                           invites[]                  @relation("invites_redeemed_byTousers")
  location_photos                                              location_photos[]
  location_ratings                                             location_ratings[]
  locations_locations_created_byTousers                        locations[]                @relation("locations_created_byTousers")
  locations_locations_updated_byTousers                        locations[]                @relation("locations_updated_byTousers")
  login_sessions                                               login_sessions[]
  member_achievements                                          member_achievements[]
  member_points                                                member_points[]
  notification_preferences                                     notification_preferences?
  notifications                                                notifications[]
  oauth_accounts                                               oauth_accounts[]
  push_subscriptions                                           push_subscriptions[]
  releases_releases_created_byTousers                          releases[]                 @relation("releases_created_byTousers")
  city                                                         cities                     @relation(fields: [cityId], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_users_city")
  invites_users_invite_idToinvites                             invites?                   @relation("users_invite_idToinvites", fields: [inviteId], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_users_invite")
  users                                                        users?                     @relation("usersTousers", fields: [invitedBy], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_users_invited_by")
  other_users                                                  users[]                    @relation("usersTousers")
  announcements_users_last_seen_announcement_idToannouncements announcements?             @relation("users_last_seen_announcement_idToannouncements", fields: [lastSeenAnnouncementId], references: [id], onUpdate: NoAction, map: "fk_users_last_seen_announcement")
  releases_users_last_seen_release_idToreleases                releases?                  @relation("users_last_seen_release_idToreleases", fields: [lastSeenReleaseId], references: [id], onUpdate: NoAction, map: "fk_users_last_seen_release")
  tenantId                                                     Int                        @default(0) @map("tenant_id") @db.UnsignedInt
  tenant                                                       tenants                    @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: NoAction, map: "fk_users_tenant")

  /// Email is unique **within** a tenant, not globally (REQ-TENANT-01.5). The
  /// same person may hold an account in two communities under one address, and
  /// each is a separate account with its own role, points and history.
  ///
  /// This replaced a global `uq_email`, which is why ~20 `findUnique({ where: {
  /// email } })` call sites had to change: an address on its own no longer
  /// identifies a row.
  @@unique([tenantId, email], map: "uq_email")
  @@index([cityId], map: "fk_users_city")
  @@index([inviteId], map: "fk_users_invite")
  @@index([lastSeenAnnouncementId], map: "fk_users_last_seen_announcement")
  @@index([lastSeenReleaseId], map: "fk_users_last_seen_release")
  @@index([emailStatus], map: "idx_email_status")
  @@index([invitedBy], map: "idx_invited_by")
  @@index([lastLoginAt], map: "idx_last_login")
  @@index([status], map: "idx_status")
  @@index([tenantId], map: "idx_users_tenant")
}

