model member_achievements {
  id            Int          @id @default(autoincrement()) @db.UnsignedInt
  memberId      Int          @map("member_id") @db.UnsignedInt
  achievementId Int          @map("achievement_id") @db.UnsignedInt
  earnedAt      DateTime     @default(now()) @map("earned_at") @db.DateTime(0)
  seenAt        DateTime?    @map("seen_at") @db.DateTime(0)
  achievement   achievements @relation(fields: [achievementId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_ma_achievement")
  member        users        @relation(fields: [memberId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_ma_member")
  tenantId      Int          @default(0) @map("tenant_id") @db.UnsignedInt
  tenant        tenants      @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: NoAction, map: "fk_member_achievements_tenant")

  /// tenantId here is a correctness fix, not tuning (v2-5): `achievements` is a
  /// global model, so its ids are shared by every tenant, and without the tenant
  /// column this index means one community granting a member an achievement
  /// permanently blocks another from doing the same.
  ///
  /// Appended rather than placed first on purpose. Uniqueness does not care
  /// about column order, but MySQL does: `member_id` leads this index and is
  /// what supports the fk_ma_member foreign key, so reordering would force the
  /// FK to be dropped and rebuilt for no behavioural gain.
  @@unique([memberId, achievementId, tenantId], map: "uq_member_achievement")
  @@index([achievementId], map: "fk_ma_achievement")
  @@index([tenantId], map: "idx_member_achievements_tenant")
}

model member_points {
  id          Int                      @id @default(autoincrement()) @db.UnsignedInt
  userId      Int                      @map("user_id") @db.UnsignedInt
  pointType   member_points_point_type @map("point_type")
  referenceId Int                      @map("reference_id") @db.UnsignedInt
  points      Int                      @default(1) @db.TinyInt
  awardedAt   DateTime                 @default(now()) @map("awarded_at") @db.DateTime(0)
  user        users                    @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_mp_user")
  tenantId    Int                      @default(0) @map("tenant_id") @db.UnsignedInt
  tenant      tenants                  @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: NoAction, map: "fk_member_points_tenant")

  /// Same reasoning as uq_member_achievement (v2-5), including why tenantId is
  /// appended rather than leading: for pointType 'achievement' the referenceId
  /// is a global achievements id, so without tenantId a point awarded in one
  /// community silently suppresses the same award in another — including through
  /// the INSERT IGNORE that adminRecalculatePoints relies on this index to
  /// backstop.
  @@unique([userId, pointType, referenceId, tenantId], map: "uq_member_points_user_type_ref")
  @@index([userId], map: "idx_mp_user")
  @@index([tenantId], map: "idx_member_points_tenant")
}

