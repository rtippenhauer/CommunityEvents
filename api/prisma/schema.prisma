// Single source of truth for the CommunityEvents data model (REQ-TENANT-01.3).
//
// Generated by `prisma db pull` against a local database built by running the
// inherited v1 TypeORM migrations, so it describes the v1 schema exactly as it
// exists today, not a redesign. Tenant scoping (tenant_id columns, the tenants
// table) arrives in v2-3 and later; do not add it here ahead of those items.
//
// Scalar fields are camelCase with @map to their snake_case columns. This is
// not cosmetic: controllers return records straight to the client, so a field
// name here IS the JSON key the Angular frontend consumes. Introspection named
// them after the columns (is_active, created_at), which would have quietly
// reshaped every API response the moment a service moved onto Prisma. The
// names now match the TypeORM entity properties one for one, verified across
// all 37 entities.
//
// That includes reproducing the entities' own inconsistencies -- announcements
// exposes the created_by column as `createdBy` while events, locations and
// event_guest_links expose it as `createdById`. Normalising those would be a
// breaking API change disguised as a cleanup, so the schema matches what each
// entity actually returns.
//
// Model names are left as the raw table names (snake_case, plural). Those are
// only ever used in code (prisma.event_rsvps), never serialised, so renaming
// them buys nothing here and would touch every call site in the same change
// that removes TypeORM.
//
// TypeORM's own `migrations` bookkeeping table is deliberately absent. It came
// back from introspection because it existed in the database that was pulled,
// but v2 starts from a blank database with the schema owned by a single Prisma
// migration, so there is no TypeORM history to record and Prisma tracks its
// own state in `_prisma_migrations`.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
}

model achievements {
  id                  Int                         @id @default(autoincrement()) @db.UnsignedInt
  key                 String                      @unique(map: "uq_achievements_key") @db.VarChar(64)
  name                String                      @db.VarChar(120)
  description         String                      @db.VarChar(500)
  icon                String                      @default("emoji_events") @db.VarChar(255)
  imagePath          String?                     @db.VarChar(500) @map("image_path")
  progressType       achievements_progress_type? @map("progress_type")
  progressTarget     Int?                        @db.UnsignedInt @map("progress_target")
  eventId            Int?                        @db.UnsignedInt @map("event_id")
  points              Int                         @default(0) @db.TinyInt
  title               String?                     @db.VarChar(100)
  isSecret           Boolean                     @default(false) @map("is_secret")
  createdAt          DateTime                    @default(now()) @db.DateTime(0) @map("created_at")
  events              events?                     @relation(fields: [eventId], references: [id], onUpdate: NoAction, map: "fk_achievements_event")
  member_achievements member_achievements[]

  @@index([eventId], map: "fk_achievements_event")
}

model announcement_comments {
  id              Int           @id @default(autoincrement()) @db.UnsignedInt
  announcementId Int           @db.UnsignedInt @map("announcement_id")
  userId         Int           @db.UnsignedInt @map("user_id")
  body            String        @db.Text
  editedAt       DateTime?     @db.DateTime(0) @map("edited_at")
  createdAt      DateTime      @default(now()) @db.DateTime(0) @map("created_at")
  deletedAt      DateTime?     @db.DateTime(0) @map("deleted_at")
  announcements   announcements @relation(fields: [announcementId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_ann_comment_ann")
  users           users         @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_ann_comment_user")

  @@index([announcementId], map: "fk_ann_comment_ann")
  @@index([userId], map: "fk_ann_comment_user")
}

model announcements {
  id                                                   Int                     @id @default(autoincrement()) @db.UnsignedInt
  title                                                String                  @db.VarChar(200)
  body                                                 String                  @db.LongText
  cityId                                              Int?                    @db.UnsignedInt @map("city_id")
  status                                               announcements_status    @default(draft)
  publishedAt                                         DateTime?               @db.DateTime(0) @map("published_at")
  createdBy                                           Int                     @db.UnsignedInt @map("created_by")
  createdAt                                           DateTime                @default(now()) @db.DateTime(0) @map("created_at")
  updatedAt                                           DateTime                @default(now()) @db.DateTime(0) @map("updated_at")
  announcement_comments                                announcement_comments[]
  users_announcements_created_byTousers                users                   @relation("announcements_created_byTousers", fields: [createdBy], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_ann_author")
  cities                                               cities?                 @relation(fields: [cityId], references: [id], onUpdate: NoAction, map: "fk_ann_city")
  users_users_last_seen_announcement_idToannouncements users[]                 @relation("users_last_seen_announcement_idToannouncements")

  @@index([createdBy], map: "fk_ann_author")
  @@index([cityId], map: "fk_ann_city")
}

model app_config {
  id           Int      @id @default(autoincrement()) @db.UnsignedInt
  configKey   String   @unique(map: "uq_config_key") @db.VarChar(100) @map("config_key")
  configValue String   @db.Text @map("config_value")
  description  String?  @db.VarChar(500)
  updatedBy   Int?     @db.UnsignedInt @map("updated_by")
  updatedAt   DateTime @default(now()) @db.DateTime(0) @map("updated_at")
}

model audit_log {
  id          Int      @id @default(autoincrement()) @db.UnsignedInt
  userId     Int?     @db.UnsignedInt @map("user_id")
  action      String   @db.VarChar(100)
  entityType String?  @db.VarChar(100) @map("entity_type")
  entityId   Int?     @db.UnsignedInt @map("entity_id")
  metadata    Json?
  ipAddress  String?  @db.VarChar(45) @map("ip_address")
  createdAt  DateTime @default(now()) @db.DateTime(0) @map("created_at")

  @@index([action], map: "idx_action")
  @@index([createdAt], map: "idx_created")
  @@index([userId], map: "idx_user")
}

model avatar {
  id         Int      @id @default(autoincrement()) @db.UnsignedInt
  path       String   @unique(map: "uq_avatar_path") @db.VarChar(500)
  label      String   @db.VarChar(100)
  sortOrder Int      @default(0) @map("sort_order")
  createdAt DateTime @default(now()) @db.DateTime(6) @map("created_at")
}

model cities {
  id                    Int                     @id @default(autoincrement()) @db.UnsignedInt
  name                  String                  @db.VarChar(100)
  subdomain             String                  @unique(map: "uq_subdomain") @db.VarChar(50)
  isActive             Boolean                 @default(true) @map("is_active")
  createdAt            DateTime                @default(now()) @db.DateTime(0) @map("created_at")
  announcements         announcements[]
  events                events[]
  facebook_group_config facebook_group_config[]
  invites               invites[]
  locations             locations[]
  users                 users[]
}

model content_flags {
  id                                     Int                        @id @default(autoincrement()) @db.UnsignedInt
  contentType                           content_flags_content_type @map("content_type")
  contentId                             Int                        @db.UnsignedInt @map("content_id")
  reportedBy                            Int                        @db.UnsignedInt @map("reported_by")
  reason                                 String?                    @db.VarChar(500)
  status                                 content_flags_status       @default(pending)
  reviewedBy                            Int?                       @db.UnsignedInt @map("reviewed_by")
  reviewedAt                            DateTime?                  @db.DateTime(0) @map("reviewed_at")
  createdAt                             DateTime                   @default(now()) @db.DateTime(0) @map("created_at")
  users_content_flags_reported_byTousers users                      @relation("content_flags_reported_byTousers", fields: [reportedBy], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_flag_reporter")
  users_content_flags_reviewed_byTousers users?                     @relation("content_flags_reviewed_byTousers", fields: [reviewedBy], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_flag_reviewer")

  @@unique([contentType, contentId, reportedBy], map: "uq_flag")
  @@index([reportedBy], map: "fk_flag_reporter")
  @@index([reviewedBy], map: "fk_flag_reviewer")
}

model content_reports {
  id                                       Int                          @id @default(autoincrement()) @db.UnsignedInt
  reporterId                              Int                          @db.UnsignedInt @map("reporter_id")
  contentType                             content_reports_content_type @map("content_type")
  contentId                               Int                          @db.UnsignedInt @map("content_id")
  reason                                   String?                      @db.VarChar(500)
  status                                   content_reports_status       @default(pending)
  reviewedBy                              Int?                         @db.UnsignedInt @map("reviewed_by")
  reviewedAt                              DateTime?                    @db.DateTime(0) @map("reviewed_at")
  createdAt                               DateTime                     @default(now()) @db.DateTime(0) @map("created_at")
  users_content_reports_reporter_idTousers users                        @relation("content_reports_reporter_idTousers", fields: [reporterId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "FK_report_reporter")
  users_content_reports_reviewed_byTousers users?                       @relation("content_reports_reviewed_byTousers", fields: [reviewedBy], references: [id], onUpdate: NoAction, map: "FK_report_reviewer")

  @@unique([reporterId, contentType, contentId], map: "UQ_report_per_member")
  @@index([reviewedBy], map: "FK_report_reviewer")
  @@index([status], map: "IDX_report_status")
}

model custom_icons {
  id         Int      @id @default(autoincrement()) @db.UnsignedInt
  name       String   @db.VarChar(100)
  imagePath String   @db.VarChar(500) @map("image_path")
  createdBy Int?     @db.UnsignedInt @map("created_by")
  createdAt DateTime @default(now()) @db.DateTime(0) @map("created_at")
  users      users?   @relation(fields: [createdBy], references: [id], onUpdate: NoAction, map: "fk_custom_icons_created_by")

  @@index([createdBy], map: "fk_custom_icons_created_by")
}

model email_provider_config {
  id                           Int      @id @default(autoincrement()) @db.UnsignedInt
  brevoEnabled                Boolean  @default(true) @map("brevo_enabled")
  resendOverflowEnabled      Boolean  @default(false) @map("resend_overflow_enabled")
  brevoDailyLimit            Int      @default(300) @map("brevo_daily_limit")
  resendDailyLimit           Int      @default(1000) @map("resend_daily_limit")
  brevoSentToday             Int      @default(0) @map("brevo_sent_today")
  resendSentToday            Int      @default(0) @map("resend_sent_today")
  brevoApiKey                String?  @db.VarChar(500) @map("brevo_api_key")
  brevoFromEmail             String?  @db.VarChar(255) @map("brevo_from_email")
  brevoFromName              String?  @db.VarChar(200) @map("brevo_from_name")
  resendApiKey               String?  @db.VarChar(500) @map("resend_api_key")
  resendFromEmail            String?  @db.VarChar(255) @map("resend_from_email")
  resendFromName             String?  @db.VarChar(200) @map("resend_from_name")
  tmplInvite                  Int?     @db.UnsignedInt @map("tmpl_invite")
  tmplSecurityAlert          Int?     @db.UnsignedInt @map("tmpl_security_alert")
  tmplEventPublished         Int?     @db.UnsignedInt @map("tmpl_event_published")
  tmplRsvpConfirmation       Int?     @db.UnsignedInt @map("tmpl_rsvp_confirmation")
  tmplEventReminder          Int?     @db.UnsignedInt @map("tmpl_event_reminder")
  tmplAccountDeletion        Int?     @db.UnsignedInt @map("tmpl_account_deletion")
  tmplReengagement60         Int?     @db.UnsignedInt @map("tmpl_reengagement_60")
  tmplReengagement90         Int?     @db.UnsignedInt @map("tmpl_reengagement_90")
  tmplGuestRsvpConfirmation Int?     @db.UnsignedInt @map("tmpl_guest_rsvp_confirmation")
  tmplEmailVerification      Int?     @db.UnsignedInt @map("tmpl_email_verification")
  tmplPasswordReset          Int?     @db.UnsignedInt @map("tmpl_password_reset")
  tmplProviderDisconnected   Int?     @db.UnsignedInt @map("tmpl_provider_disconnected")
  tmplAccountDeleted         Int?     @db.UnsignedInt @map("tmpl_account_deleted")
  lastResetDate              DateTime @db.Date @map("last_reset_date")
  updatedAt                   DateTime @default(now()) @db.DateTime(0) @map("updated_at")
}

model email_queue {
  id              Int                   @id @default(autoincrement()) @db.UnsignedInt
  toEmail        String                @db.VarChar(255) @map("to_email")
  toName         String?               @db.VarChar(200) @map("to_name")
  subject         String                @db.VarChar(500)
  templateId     String?               @db.VarChar(100) @map("template_id")
  templateParams Json? @map("template_params")
  htmlBody       String?               @db.LongText @map("html_body")
  textBody       String?               @db.Text @map("text_body")
  priority        Int                   @default(5) @db.TinyInt
  status          email_queue_status    @default(pending)
  provider        email_queue_provider?
  attempts        Int                   @default(0)
  lastAttemptAt DateTime?             @db.DateTime(0) @map("last_attempt_at")
  errorMessage   String?               @db.Text @map("error_message")
  brevoStatus    String?               @db.VarChar(100) @map("brevo_status")
  sendAfter      DateTime?             @db.DateTime(0) @map("send_after")
  createdAt      DateTime              @default(now()) @db.DateTime(0) @map("created_at")
  sentAt         DateTime?             @db.DateTime(0) @map("sent_at")

  @@index([sendAfter], map: "idx_send_after")
  @@index([status, priority], map: "idx_status_priority")
}

model email_suppressions {
  id         Int                       @id @default(autoincrement()) @db.UnsignedInt
  emailHash String                    @unique(map: "uq_email_hash") @db.VarChar(255) @map("email_hash")
  reason     email_suppressions_reason
  createdAt DateTime                  @default(now()) @db.DateTime(0) @map("created_at")
}

model event_comment_replies {
  id             Int            @id @default(autoincrement()) @db.UnsignedInt
  commentId     Int            @db.UnsignedInt @map("comment_id")
  memberId      Int            @db.UnsignedInt @map("member_id")
  body           String         @db.Text
  editedAt      DateTime?      @db.DateTime(0) @map("edited_at")
  createdAt     DateTime       @default(now()) @db.DateTime(0) @map("created_at")
  deletedAt     DateTime?      @db.DateTime(0) @map("deleted_at")
  event_comments event_comments @relation(fields: [commentId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_ecr_comment")
  users          users          @relation(fields: [memberId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_ecr_member")

  @@index([commentId], map: "idx_ecr_comment")
  @@index([memberId], map: "idx_ecr_member")
}

model event_comments {
  id                    Int                     @id @default(autoincrement()) @db.UnsignedInt
  eventId              Int                     @db.UnsignedInt @map("event_id")
  memberId             Int                     @db.UnsignedInt @map("member_id")
  body                  String                  @db.Text
  editedAt             DateTime?               @db.DateTime(0) @map("edited_at")
  createdAt            DateTime                @default(now()) @db.DateTime(0) @map("created_at")
  deletedAt            DateTime?               @db.DateTime(0) @map("deleted_at")
  event_comment_replies event_comment_replies[]
  events                events                  @relation(fields: [eventId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_ec_event")
  users                 users                   @relation(fields: [memberId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_ec_member")

  @@index([eventId], map: "idx_ec_event")
  @@index([memberId], map: "idx_ec_member")
}

model event_guest_links {
  id              Int                             @id @default(autoincrement()) @db.UnsignedInt
  eventId        Int                             @db.UnsignedInt @map("event_id")
  createdById      Int?                            @db.UnsignedInt @map("created_by")
  memberRsvpId  Int?                            @db.UnsignedInt @map("member_rsvp_id")
  deliveryType   event_guest_links_delivery_type @default(shareable) @map("delivery_type")
  source          event_guest_links_source        @default(member)
  recipientName  String?                         @db.VarChar(200) @map("recipient_name")
  recipientEmail String?                         @db.VarChar(255) @map("recipient_email")
  token           String                          @unique(map: "uq_token") @db.VarChar(100)
  expiresAt      DateTime                        @db.DateTime(0) @map("expires_at")
  usedAt         DateTime?                       @db.DateTime(0) @map("used_at")
  cancelledAt    DateTime?                       @db.DateTime(0) @map("cancelled_at")
  attended        Boolean?
  createdAt      DateTime                        @default(now()) @db.DateTime(0) @map("created_at")
  events          events                          @relation(fields: [eventId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_guestlink_event")
  event_rsvps     event_rsvps?                    @relation(fields: [memberRsvpId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_guestlink_rsvp")
  users           users?                          @relation(fields: [createdById], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_guestlink_user")

  @@index([createdById], map: "idx_created_by")
  @@index([eventId], map: "idx_event")
  @@index([memberRsvpId], map: "idx_rsvp")
}

model event_rsvps {
  id                Int                 @id @default(autoincrement()) @db.UnsignedInt
  eventId          Int                 @db.UnsignedInt @map("event_id")
  userId           Int                 @db.UnsignedInt @map("user_id")
  additionalGuests Int                 @default(0) @db.UnsignedTinyInt @map("additional_guests")
  guestNames       Json? @map("guest_names")
  bringingItem     String?             @db.VarChar(200) @map("bringing_item")
  createdAt        DateTime            @default(now()) @db.DateTime(0) @map("created_at")
  updatedAt        DateTime            @default(now()) @db.DateTime(0) @map("updated_at")
  status            event_rsvps_status  @default(going)
  attended          Boolean?
  isWalkin         Boolean             @default(false) @map("is_walkin")
  fromOtherCity   Boolean             @default(false) @map("from_other_city")
  event_guest_links event_guest_links[]
  events            events              @relation(fields: [eventId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_rsvp_event")
  users             users               @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_rsvp_user")

  @@unique([eventId, userId], map: "uq_event_member")
  @@index([eventId], map: "idx_event")
  @@index([userId], map: "idx_user")
}

model events {
  id                                          Int                 @id @default(autoincrement()) @db.UnsignedInt
  cityId                                     Int                 @db.UnsignedInt @map("city_id")
  locationId                                 Int?                @db.UnsignedInt @map("location_id")
  locationName                               String              @db.VarChar(255) @map("location_name")
  locationAddress                            String              @db.VarChar(500) @map("location_address")
  locationLat                                Decimal?            @db.Decimal(10, 7) @map("location_lat")
  locationLng                                Decimal?            @db.Decimal(10, 7) @map("location_lng")
  title                                       String              @db.VarChar(255)
  description                                 String?             @db.Text
  additionalInfo                             String?             @db.Text @map("additional_info")
  eventDate                                  DateTime            @db.Date @map("event_date")
  eventTime                                  DateTime            @db.Time(0) @map("event_time")
  status                                      events_status       @default(draft)
  publishedAt                                DateTime?           @db.DateTime(0) @map("published_at")
  cancelledAt                                DateTime?           @db.DateTime(0) @map("cancelled_at")
  cancelledReason                            String?             @db.Text @map("cancelled_reason")
  facebookShareText                         String?             @db.Text @map("facebook_share_text")
  reservationAssigneeId                     Int?                @db.UnsignedInt @map("reservation_assignee_id")
  reservationContactName                    String?             @db.VarChar(150) @map("reservation_contact_name")
  reservationContactEmail                   String?             @db.VarChar(255) @map("reservation_contact_email")
  reservationConfirmed                       Boolean             @default(false) @map("reservation_confirmed")
  reservationConfirmedBy                    String?             @db.VarChar(255) @map("reservation_confirmed_by")
  reservationConfirmedAt                    DateTime?           @db.DateTime(0) @map("reservation_confirmed_at")
  reservationConfirmedNote                  String?             @db.VarChar(500) @map("reservation_confirmed_note")
  reservationSeatsEmailSent                Boolean             @default(false) @map("reservation_seats_email_sent")
  reservationConfirmToken                   String?             @unique(map: "uq_events_reservation_token") @db.VarChar(64) @map("reservation_confirm_token")
  createdById                                  Int                 @db.UnsignedInt @map("created_by")
  createdAt                                  DateTime            @default(now()) @db.DateTime(0) @map("created_at")
  updatedAt                                  DateTime            @default(now()) @db.DateTime(0) @map("updated_at")
  isSecret                                   Boolean             @default(false) @map("is_secret")
  achievements                                achievements[]
  event_comments                              event_comments[]
  event_guest_links                           event_guest_links[]
  event_rsvps                                 event_rsvps[]
  cities                                      cities              @relation(fields: [cityId], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_event_city")
  users_events_created_byTousers              users               @relation("events_created_byTousers", fields: [createdById], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_event_created_by")
  locations                                   locations?          @relation(fields: [locationId], references: [id], onUpdate: NoAction, map: "fk_event_location")
  users_events_reservation_assignee_idTousers users?              @relation("events_reservation_assignee_idTousers", fields: [reservationAssigneeId], references: [id], onUpdate: NoAction, map: "fk_events_reservation_assignee")
  location_ratings                            location_ratings[]

  @@index([createdById], map: "fk_event_created_by")
  @@index([locationId], map: "fk_event_location")
  @@index([reservationAssigneeId], map: "fk_events_reservation_assignee")
  @@index([cityId, eventDate], map: "idx_city_date")
  @@index([status], map: "idx_status")
}

model facebook_deletion_requests {
  id                  Int                               @id @default(autoincrement()) @db.UnsignedInt
  facebookUserId    String                            @db.VarChar(255) @map("facebook_user_id")
  confirmationCode   String                            @unique(map: "UQ_fb_deletion_code") @db.VarChar(100) @map("confirmation_code")
  dinnerbearsUserId Int?                              @db.UnsignedInt @map("dinnerbears_user_id")
  status              facebook_deletion_requests_status @default(pending)
  requestedAt        DateTime                          @default(now()) @db.DateTime(0) @map("requested_at")
  completedAt        DateTime?                         @db.DateTime(0) @map("completed_at")

  @@index([facebookUserId], map: "IDX_fb_deletion_user_id")
}

model facebook_group_config {
  id         Int                              @id @default(autoincrement()) @db.UnsignedInt
  name       String                           @db.VarChar(255)
  url        String                           @db.VarChar(500)
  groupId   String?                          @db.VarChar(50) @map("group_id")
  cityId    Int?                             @db.UnsignedInt @map("city_id")
  groupRole facebook_group_config_group_role @default(primary) @map("group_role")
  isActive  Boolean                          @default(true) @map("is_active")
  createdAt DateTime                         @default(now()) @db.DateTime(0) @map("created_at")
  updatedAt DateTime                         @default(now()) @db.DateTime(0) @map("updated_at")
  cities     cities?                          @relation(fields: [cityId], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_fbgroup_city")
  invites    invites[]

  @@index([cityId], map: "fk_fbgroup_city")
}

model feedback {
  id               Int                @id @default(autoincrement()) @db.UnsignedInt
  userId          Int                @db.UnsignedInt @map("user_id")
  title            String?            @db.VarChar(200)
  category         feedback_category
  body             String             @db.Text
  status           feedback_status    @default(open)
  adminNote       String?            @db.Text @map("admin_note")
  releaseNote     String?            @db.VarChar(500) @map("release_note")
  isPrivate       Boolean            @default(false) @map("is_private")
  upvoteCount     Int                @default(0) @db.UnsignedInt @map("upvote_count")
  seenAt          DateTime?          @db.DateTime(0) @map("seen_at")
  resolvedAt      DateTime?          @db.DateTime(0) @map("resolved_at")
  createdAt       DateTime           @default(now()) @db.DateTime(0) @map("created_at")
  updatedAt       DateTime           @default(now()) @db.DateTime(0) @map("updated_at")
  users            users              @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_feedback_user")
  feedback_notes   feedback_notes[]
  feedback_upvotes feedback_upvotes[]
  release_feedback release_feedback[]

