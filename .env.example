# =============================================================================
# CommunityEvents — Environment Variables
# Copy this file to .env and fill in all values
# NEVER commit .env to git
# =============================================================================
#
# REQ-TENANT-01.4 splits this file into two kinds of setting, and the
# distinction is worth knowing before editing anything:
#
#   BOOTSTRAP — read before a tenant can be resolved, because it is how the
#     process reaches the database or finds the root tenant in it. It cannot
#     live in the database by definition. Small on purpose: the DB_* block,
#     APP_URL/ROOT_TENANT_URL, JWT_SECRET, EMAIL_SUPPRESSION_SALT and
#     SECRET_ENCRYPTION_KEY.
#
#   RUNTIME — a deployment-wide DEFAULT for something each community can now
#     override for itself in Settings (app_config is tenant-scoped as of v2-6).
#     Contact addresses and mail identity are the main ones. Editing the value
#     here changes what a community gets when it has not chosen its own; it
#     does not overwrite one that has.
#
#   INSTALL — read once by bootstrap.js / provision-tenant.js and never by a
#     request. After the first run the value lives in the database, and editing
#     it here changes nothing.
#
# Credentials are encrypted at rest as of v2-7, so a few of them are no longer
# stuck here: GEOCODING_API_KEY, GOOGLE_PLACES_API_KEY and ANTHROPIC_API_KEY are
# now the deployment-wide DEFAULT for a value each community can set for itself
# (Admin -> Secrets), exactly like a RUNTIME setting. The rest stay, either
# because they belong to the deployment or because their real home is a column
# a later item populates -- see the notes in env-classification.ts.
#
# The full classification, one line per variable with the reasoning, is
# api/src/common/config/env-classification.ts. A test asserts it stays in step
# with this file, so a new variable added here has to be classified there.

# -----------------------------------------------------------------------------
# Database
# -----------------------------------------------------------------------------
DB_HOST=192.168.2.241
DB_PORT=3306
DB_NAME=dinnerbears
DB_USER=dinnerbears_user
DB_PASSWORD=
DB_ROOT_PASSWORD=

# -----------------------------------------------------------------------------
# Secret encryption (v2-7) — BOOTSTRAP, required
#
# Every credential stored in the database is encrypted under this key: the email
# provider API keys, each community's own third-party keys, and the per-tenant
# OAuth secrets v2-8 adds. The API refuses to start without it.
#
# Optional. Leave blank and a brand-new deployment generates its own on first
# start, writing it to SECRET_ENCRYPTION_KEY_FILE below -- so a fresh install
# needs nothing here. Set it to supply a key explicitly, or to hand an existing
# database the key its secrets were written under.
#
# Generating only happens when the database holds no secrets. A deployment that
# has any will refuse to start rather than come up with a key that cannot read
# them, naming the key id it needs.
#
# KEEP A COPY somewhere other than this file (and other than the key file). A
# lost key means every stored secret has to be re-entered from its provider --
# `npm run secrets:reset` is the supported way to discard them and start over.
#
# Generate one yourself with: openssl rand -base64 32
#
# To rotate: move the current key into SECRET_ENCRYPTION_KEYS_RETIRED, put the
# new one here, restart, then run `npm run secrets:rewrap` and drop the retired
# key once it reports nothing left to do. Nothing is re-entered and there is no
# window where the deployment is down.
# -----------------------------------------------------------------------------
SECRET_ENCRYPTION_KEY=
SECRET_ENCRYPTION_KEYS_RETIRED=
# Where a generated key lives. The default is on the container's persistent
# appdata volume, so it survives a rebuild; only change it if that volume is
# mounted elsewhere. Never read when SECRET_ENCRYPTION_KEY is set.
SECRET_ENCRYPTION_KEY_FILE=/app/appdata/secret-encryption.key

# -----------------------------------------------------------------------------
# JWT
# -----------------------------------------------------------------------------
JWT_SECRET=
JWT_EXPIRES_IN=7d

# -----------------------------------------------------------------------------
# Google OAuth
# -----------------------------------------------------------------------------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=https://dinnerbears.com/api/v1/auth/google/callback

# -----------------------------------------------------------------------------
# Facebook OAuth
# -----------------------------------------------------------------------------
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
FACEBOOK_CALLBACK_URL=https://dinnerbears.com/api/v1/auth/facebook/callback

# -----------------------------------------------------------------------------
# Facebook Groups (display/reference only — no API calls)
# -----------------------------------------------------------------------------
FACEBOOK_GROUP_1_CINCINNATI_ID=
FACEBOOK_GROUP_1_DAYTON_ID=
FACEBOOK_GROUP_2_DAYTON_ID=

# -----------------------------------------------------------------------------
# Email — Brevo
# -----------------------------------------------------------------------------
BREVO_API_KEY=
BREVO_FROM_EMAIL=noreply@dinnerbears.com
BREVO_FROM_NAME=DinnerBears

# Brevo transactional template IDs (found in Brevo dashboard > Templates)
BREVO_TEMPLATE_INVITE=
BREVO_TEMPLATE_SECURITY_ALERT=
BREVO_TEMPLATE_EVENT_PUBLISHED=
BREVO_TEMPLATE_RSVP_CONFIRMATION=
BREVO_TEMPLATE_EVENT_REMINDER=
BREVO_TEMPLATE_ACCOUNT_DELETION=
BREVO_TEMPLATE_REENGAGEMENT_60=
BREVO_TEMPLATE_REENGAGEMENT_90=
BREVO_TEMPLATE_GUEST_RSVP_CONFIRMATION=
BREVO_TEMPLATE_EMAIL_VERIFICATION=
BREVO_TEMPLATE_PASSWORD_RESET=

# -----------------------------------------------------------------------------
# Email — Gmail SMTP Fallback
# -----------------------------------------------------------------------------
GMAIL_USER=
GMAIL_APP_PASSWORD=
GMAIL_FROM_EMAIL=noreply@dinnerbears.com
GMAIL_FROM_NAME=DinnerBears

# -----------------------------------------------------------------------------
# Email Suppression
# Salt for SHA-256 hashing of emails in email_suppressions table
# Generate with: openssl rand -hex 32
# -----------------------------------------------------------------------------
EMAIL_SUPPRESSION_SALT=

# -----------------------------------------------------------------------------
# VAPID Keys (Web Push)
# Generate with: npx web-push generate-vapid-keys
# -----------------------------------------------------------------------------
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@dinnerbears.com

# -----------------------------------------------------------------------------
# Geocoding
# -----------------------------------------------------------------------------
# Per-community as of v2-7: this is the default a community inherits until it
# sets its own key in Admin -> Secrets.
GEOCODING_API_KEY=
GEOCODING_PROVIDER=google

# -----------------------------------------------------------------------------
# Location enrichment (Google Places + optional AI descriptions)
# -----------------------------------------------------------------------------
# Powers the "search for a place" box when adding a location, plus the
# enrichment that fills in phone, website, address and photos, and the Street
# View fallback for venues with no Places photos.
#
# Needs the *Places API* enabled on the Google Cloud project and billing turned
# on, not just a key. Without a usable key the place-search box silently
# returns no results -- the code logs the reason at warn level, so check the
# container log rather than guessing.
# Per-community as of v2-7, like GEOCODING_API_KEY.
GOOGLE_PLACES_API_KEY=

# Optional. When set, generates a short description for a newly added location
# from its Places data. Locations are created without one if this is absent --
# nothing else depends on it.
# Per-community as of v2-7, like GEOCODING_API_KEY.
ANTHROPIC_API_KEY=

# -----------------------------------------------------------------------------
# Tenancy (REQ-TENANT-01)
# -----------------------------------------------------------------------------
# The root tenant's row is created by bootstrap.js with is_root = true, and an
# admin on it is the system admin. Its domain normally comes from APP_URL below
# -- so a stage and a production instance differ by APP_URL alone, and there is
# no second hostname setting to leave at a copied default.
#
# The domain is stored bare and lower-cased: "https://www.example.com" and
# "example.com" both become "example.com", because www.<domain> and <domain> are
# the same tenant and must never become two rows. Other tenants are subdomains
# of the same apex; a stage deployment is its own root tenant, not a tenant of
# production, so point its APP_URL at the stage host and give it its own
# database.
#
# Set ROOT_TENANT_URL only if the root tenant is served from a different host
# than the app itself, which has not happened yet. BASE_DOMAIN is not consulted:
# that is the mail domain (calendar@, hello@, noreply@ derive from it), and a
# tenant's domain is a web host.
# ROOT_TENANT_URL=

# Slug for that tenant row. Cosmetic; only needs changing if "root" collides
# with a tenant slug you actually want.
ROOT_TENANT_SLUG=root

# -----------------------------------------------------------------------------
# App
# -----------------------------------------------------------------------------
NODE_ENV=development
APP_URL=https://dinnerbears.com
FRONTEND_PORT=8080
API_PORT=3000

# Stage vs. prod. Set IS_STAGE=true on non-production instances — it flags the
# UI as a stage build and widens the login achievement dedup window. IMPORTANT:
# a stage instance must still run NODE_ENV=production alongside IS_STAGE=true;
# a NODE_ENV of "staging" leaves cookies non-Secure and can leak stack traces.
IS_STAGE=false

# Contact-email domain. Optional — defaults to the APP_URL host with a leading
# "www." stripped.
#
# NO LONGER THE COOKIE SCOPE. As of v2-6 the session cookie is host-only: it has
# no Domain attribute at all, so it belongs to the exact tenant host that issued
# it. A tenant IS a domain under v2, so scoping the cookie to a shared parent
# would have meant one login valid across every community on the deployment.
# This value is still read when clearing cookies issued before that change, and
# can be dropped once no such session can still exist.
#
# Use the BARE domain, never "www." — contact addresses (calendar@, hello@,
# noreply@) are derived from this, and www.<domain> normally has no MX record,
# so anything sent there bounces. The code strips a leading "www." defensively.
BASE_DOMAIN=dinnerbears.com

# -----------------------------------------------------------------------------
# Install & provisioning (INSTALL)
# -----------------------------------------------------------------------------
# These drive the one-time install. None of them is read while serving
# requests, so changing one on a deployment that is already set up does
# nothing at all.

# Runs seed + bootstrap automatically on container start, instead of you
# shelling in and running them by hand. Off by default and opt-in on purpose:
# each step is individually gated on a first-install condition, but turning a
# once-per-lifetime install into something a restart can do is a decision, not
# something to inherit silently from an image upgrade.
#
# Set this to "true" for an unattended first deploy. Leaving it unset means a
# freshly migrated database has no tenant, and every request answers 503
# TENANT_NOT_CONFIGURED until you run `node dist/bootstrap.js` yourself.
# AUTO_PROVISION=false

# Adding a SECOND community from the command line, as opposed to through the
# system-admin UI. Guard rail rather than a toggle: set it to the exact database
# name you intend to write to, and the script refuses if it does not match what
# DB_NAME points at -- the mistake being prevented is running a provision
# against production while a stage shell is open.
# ALLOW_TENANT_PROVISION=
# TENANT_DOMAIN=dayton.communityeventsproject.com
# TENANT_SLUG=dayton
# TENANT_STATUS=active

# Demo/test data. Same database-name guard rail, for the same reason, and it
# refuses outright on a database it was not pointed at explicitly.
# ALLOW_TEST_DATA=
# TEST_DATA_TENANT=
# TEST_MEMBER_COUNT=20
# TEST_MEMBER_CITY_ID=1
# TEST_MEMBER_EMAIL_PATTERN=member+{n}@example.com
# TEST_MEMBER_PASSWORD=
# TEST_EVENT_COUNT=8

# -----------------------------------------------------------------------------
# Operational (DEPLOYMENT)
# -----------------------------------------------------------------------------
# How long a resolved tenant stays cached, in milliseconds. The cache key is an
# attacker-controlled Host header, so misses are cached too and the table is
# size-bounded. Lower it while changing domains; the default is fine otherwise.
# TENANT_CACHE_TTL_MS=30000

# Where finalized release notes are read from at boot. Defaults to
# ./release-notes; the image sets it and there is normally no reason to.
# RELEASE_NOTES_DIR=

# Stamped by scripts/publish-v2-stage.sh so a running container can report the
# commit it was built from. Do not set by hand.
# GIT_COMMIT=

# -----------------------------------------------------------------------------
# Secrets not shown above (SECRET — stay in env until v2-7)
# -----------------------------------------------------------------------------
# Verifies inbound Brevo delivery/bounce webhooks. Unset means the webhook
# endpoint accepts anything that reaches it, so set it if the endpoint is
# publicly routable.
# BREVO_WEBHOOK_SECRET=

# Lets the automation account sign in without a browser, for driving the app
# during testing. Platform-wide by design even after v2-7: the login path only
# ever admits the ROOT tenant's service account, so a per-tenant copy would be a
# credential with nothing to open. Leave unset to disable automation login.
# CLAUDE_AUTOMATION_SECRET=
