# ============================================================
# DinnerBears.com — Environment Variables
# Copy this file to .env and fill in all values.
# NEVER commit .env to version control.
# ============================================================

# ── Application ──────────────────────────────────────────────
NODE_ENV=development
APP_URL=http://localhost:4200
API_URL=http://localhost:3000

# ── Database (MySQL) ─────────────────────────────────────────
DB_HOST=mysql
DB_PORT=3306
DB_NAME=dinnerbears
DB_USER=dinnerbears_user
DB_PASSWORD=change_this_password
DB_ROOT_PASSWORD=change_this_root_password

# ── Authentication ───────────────────────────────────────────
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=generate_a_long_random_string_here
JWT_EXPIRES_IN=24h
JWT_REFRESH_EXPIRES_IN=30d

# ── Google OAuth ─────────────────────────────────────────────
# From Google Cloud Console → APIs & Services → Credentials
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret
# Redirect URI (add this to Google Console allowed URIs):
# http://localhost:3000/api/v1/auth/google/callback (dev)
# https://dinnerbears.com/api/v1/auth/google/callback (prod)

# ── Facebook OAuth ───────────────────────────────────────────
# From Meta for Developers → Your App → Settings → Basic
# Same Meta App used for Facebook event posting (see FACEBOOK_GRAPH_TOKEN below)
FACEBOOK_CLIENT_ID=your_facebook_app_id
FACEBOOK_CLIENT_SECRET=your_facebook_app_secret
# Redirect URI (add to Meta App → Facebook Login → Valid OAuth Redirect URIs):
# http://localhost:3000/api/v1/auth/facebook/callback (dev)
# https://dinnerbears.com/api/v1/auth/facebook/callback (prod)

# ── Email — Brevo (Primary) ──────────────────────────────────
# From Brevo dashboard → SMTP & API → API Keys → Create new key
BREVO_API_KEY=your_brevo_api_key
BREVO_FROM_EMAIL=noreply@dinnerbears.com
BREVO_FROM_NAME=DinnerBears
BREVO_DAILY_LIMIT=300

# Brevo Template IDs (fill in after creating templates in Brevo dashboard)
BREVO_TEMPLATE_WELCOME=
BREVO_TEMPLATE_INVITE=
BREVO_TEMPLATE_PASSWORD_RESET=
BREVO_TEMPLATE_NEW_EVENT=
BREVO_TEMPLATE_EVENT_CHANGED=
BREVO_TEMPLATE_EVENT_CANCELLED=
BREVO_TEMPLATE_RSVP_CONFIRMATION=
BREVO_TEMPLATE_ANNOUNCEMENT=
BREVO_TEMPLATE_NEW_MEMBER_JOINED=

# ── Email — Gmail SMTP (Overflow / Emergency Backup) ─────────
# From Google Account → Security → 2-Step Verification → App Passwords
# Label: "DinnerBears SMTP"
GMAIL_SMTP_HOST=smtp.gmail.com
GMAIL_SMTP_PORT=587
GMAIL_SMTP_USER=your_gmail_address@gmail.com
GMAIL_SMTP_APP_PASSWORD=xxxx-xxxx-xxxx-xxxx
GMAIL_FROM_NAME=DinnerBears
GMAIL_DAILY_LIMIT=500

# ── Web Push (VAPID) ─────────────────────────────────────────
# Generate once with: npx web-push generate-vapid-keys
# Store these permanently — changing them invalidates all push subscriptions
VAPID_PUBLIC_KEY=your_vapid_public_key
VAPID_PRIVATE_KEY=your_vapid_private_key
VAPID_SUBJECT=mailto:admin@dinnerbears.com

# ── Geocoding ────────────────────────────────────────────────
# Decision pending (OI-001): Google Maps, Nominatim, or Mapbox
# Google Maps Geocoding API key (if using Google):
GEOCODING_API_KEY=your_geocoding_api_key
GEOCODING_PROVIDER=google

# ── Facebook Graph API (Event Posting) ───────────────────────
# From Meta for Developers → Your App → Tools → Graph API Explorer
# Required permissions: pages_manage_posts, groups_access_member_info
# Same Meta App as Facebook OAuth above — different token type
FACEBOOK_GRAPH_TOKEN=your_long_lived_page_token
FACEBOOK_CINCINNATI_GROUP_ID=your_cincinnati_group_id
FACEBOOK_DAYTON_GROUP_ID=your_dayton_group_id_when_available

# ── NGINX / Subdomain ────────────────────────────────────────
# For local dev, add to /etc/hosts:
# 127.0.0.1 cincinnati.localhost
# 127.0.0.1 dayton.localhost
DEFAULT_CITY=cincinnati
