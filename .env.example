# =============================================================================
# DinnerBears — Environment Variables
# Copy this file to .env and fill in all values
# NEVER commit .env to git
# =============================================================================

# -----------------------------------------------------------------------------
# Database
# -----------------------------------------------------------------------------
DB_HOST=192.168.2.241
DB_PORT=3306
DB_NAME=dinnerbears
DB_USER=dinnerbears_user
DB_PASSWORD=
DB_ROOT_PASSWORD=

# -----------------------------------------------------------------------------
# JWT
# -----------------------------------------------------------------------------
JWT_SECRET=
JWT_EXPIRES_IN=7d

# -----------------------------------------------------------------------------
# Google OAuth
# -----------------------------------------------------------------------------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=https://dinnerbears.com/api/v1/auth/google/callback

# -----------------------------------------------------------------------------
# Facebook OAuth
# -----------------------------------------------------------------------------
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
FACEBOOK_CALLBACK_URL=https://dinnerbears.com/api/v1/auth/facebook/callback

# -----------------------------------------------------------------------------
# Facebook Groups (display/reference only — no API calls)
# -----------------------------------------------------------------------------
FACEBOOK_GROUP_1_CINCINNATI_ID=
FACEBOOK_GROUP_1_DAYTON_ID=
FACEBOOK_GROUP_2_DAYTON_ID=

# -----------------------------------------------------------------------------
# Email — Brevo
# -----------------------------------------------------------------------------
BREVO_API_KEY=
BREVO_FROM_EMAIL=noreply@dinnerbears.com
BREVO_FROM_NAME=DinnerBears

# Brevo transactional template IDs (found in Brevo dashboard > Templates)
BREVO_TEMPLATE_INVITE=
BREVO_TEMPLATE_SECURITY_ALERT=
BREVO_TEMPLATE_EVENT_PUBLISHED=
BREVO_TEMPLATE_RSVP_CONFIRMATION=
BREVO_TEMPLATE_EVENT_REMINDER=
BREVO_TEMPLATE_ACCOUNT_DELETION=
BREVO_TEMPLATE_REENGAGEMENT_60=
BREVO_TEMPLATE_REENGAGEMENT_90=
BREVO_TEMPLATE_GUEST_RSVP_CONFIRMATION=
BREVO_TEMPLATE_EMAIL_VERIFICATION=
BREVO_TEMPLATE_PASSWORD_RESET=

# -----------------------------------------------------------------------------
# Email — Gmail SMTP Fallback
# -----------------------------------------------------------------------------
GMAIL_USER=
GMAIL_APP_PASSWORD=
GMAIL_FROM_EMAIL=noreply@dinnerbears.com
GMAIL_FROM_NAME=DinnerBears

# -----------------------------------------------------------------------------
# Email Suppression
# Salt for SHA-256 hashing of emails in email_suppressions table
# Generate with: openssl rand -hex 32
# -----------------------------------------------------------------------------
EMAIL_SUPPRESSION_SALT=

# -----------------------------------------------------------------------------
# VAPID Keys (Web Push)
# Generate with: npx web-push generate-vapid-keys
# -----------------------------------------------------------------------------
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@dinnerbears.com

# -----------------------------------------------------------------------------
# Geocoding
# -----------------------------------------------------------------------------
GEOCODING_API_KEY=
GEOCODING_PROVIDER=google

# -----------------------------------------------------------------------------
# App
# -----------------------------------------------------------------------------
NODE_ENV=development
APP_URL=https://dinnerbears.com
FRONTEND_PORT=8080
API_PORT=3000

# Stage vs. prod. Set IS_STAGE=true on non-production instances — it flags the
# UI as a stage build and widens the login achievement dedup window. IMPORTANT:
# a stage instance must still run NODE_ENV=production alongside IS_STAGE=true;
# a NODE_ENV of "staging" leaves cookies non-Secure and can leak stack traces.
IS_STAGE=false

# Cookie scope + contact-email domain. Optional — defaults to the APP_URL host
# with a leading "www." stripped. Set explicitly only if the cookie/base domain
# should differ from APP_URL's host (e.g. a shared parent domain across
# subdomains).
# Use the BARE domain, never "www." — contact addresses (calendar@, hello@,
# noreply@) are derived from this, and www.<domain> normally has no MX record,
# so anything sent there bounces. The code strips a leading "www." defensively,
# but the cookie scope uses this value as written.
BASE_DOMAIN=dinnerbears.com
