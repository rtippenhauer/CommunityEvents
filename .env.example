# ============================================================
# DinnerBears — Environment Variables
# Copy this file to .env and fill in real values.
# NEVER commit .env to git.
# ============================================================

# ── App ──────────────────────────────────────────────────────
NODE_ENV=development
PORT=3000

# ── Database ─────────────────────────────────────────────────
DB_HOST=mysql
DB_PORT=3306
DB_NAME=dinnerbears
DB_USER=dinnerbears
DB_PASSWORD=changeme
DB_ROOT_PASSWORD=changeme_root

# ── Auth / JWT ────────────────────────────────────────────────
JWT_SECRET=change_this_to_a_long_random_secret
JWT_EXPIRES_IN=7d

# ── Google OAuth ──────────────────────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── Facebook OAuth ────────────────────────────────────────────
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=

# ── Brevo (primary email — 300/day limit) ────────────────────
BREVO_API_KEY=
BREVO_FROM_EMAIL=noreply@dinnerbears.com
BREVO_FROM_NAME=DinnerBears
BREVO_DAILY_LIMIT=300

# ── Gmail SMTP (overflow fallback — 500/day limit) ───────────
GMAIL_SMTP_HOST=smtp.gmail.com
GMAIL_SMTP_PORT=587
GMAIL_SMTP_USER=
GMAIL_SMTP_APP_PASSWORD=
GMAIL_FROM_NAME=DinnerBears
GMAIL_DAILY_LIMIT=500

# ── Web Push / VAPID ─────────────────────────────────────────
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@dinnerbears.com

# ── Geocoding ─────────────────────────────────────────────────
GEOCODING_API_KEY=
GEOCODING_PROVIDER=google

# ── Facebook Graph API ────────────────────────────────────────
FACEBOOK_GRAPH_TOKEN=
FACEBOOK_CINCINNATI_GROUP_ID=
FACEBOOK_DAYTON_GROUP_ID=
