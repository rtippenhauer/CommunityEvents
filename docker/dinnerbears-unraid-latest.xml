<?xml version="1.0"?>
<Container version="2">
  <Name>DinnerBears</Name>
  <Repository>dinnerbears/app:latest</Repository>
  <Registry/>
  <Network>bridge</Network>
  <MyIP/>
  <Shell>bash</Shell>
  <Privileged>false</Privileged>
  <Support/>
  <Project>https://github.com/rtippenhauer/DinnerBears</Project>
  <Overview>DinnerBears community dining platform — Production. Invite-only weekly dinner group for Cincinnati and Dayton. Angular frontend + NestJS API via NGINX. To edit environment variables directly, place a .env file at /mnt/user/appdata/dinnerbears/latest/.env and mount it into the container.</Overview>
  <Category>Tools:</Category>
  <WebUI>http://[IP]:[PORT:8050]/</WebUI>
  <TemplateURL/>
  <Icon/>
  <ExtraParams>--restart unless-stopped</ExtraParams>
  <PostArgs/>
  <CPUset/>
  <DateInstalled/>
  <DonateText/>
  <DonateLink/>
  <Requires/>

  <!-- ==================== PORTS ==================== -->
  <Config Name="Web Port" Target="8080" Default="8050" Mode="tcp"
    Description="Production web port" Type="Port"
    Display="always" Required="true" Mask="false">8050</Config>

  <!-- ==================== DATABASE ==================== -->
  <Config Name="DB Host" Target="DB_HOST" Default="192.168.2.241" Mode=""
    Description="MySQL host IP" Type="Variable"
    Display="always" Required="true" Mask="false">192.168.2.241</Config>
  <Config Name="DB Port" Target="DB_PORT" Default="3306" Mode=""
    Description="MySQL port" Type="Variable"
    Display="always" Required="true" Mask="false">3306</Config>
  <Config Name="DB Name" Target="DB_NAME" Default="dinnerbears" Mode=""
    Description="MySQL database name" Type="Variable"
    Display="always" Required="true" Mask="false">dinnerbears</Config>
  <Config Name="DB User" Target="DB_USER" Default="dinnerbears_user" Mode=""
    Description="MySQL username" Type="Variable"
    Display="always" Required="true" Mask="false">dinnerbears_user</Config>
  <Config Name="DB Password" Target="DB_PASSWORD" Default="" Mode=""
    Description="MySQL password" Type="Variable"
    Display="always" Required="true" Mask="true"></Config>
  <Config Name="DB Root Password" Target="DB_ROOT_PASSWORD" Default="" Mode=""
    Description="MySQL root password (used by migrations)" Type="Variable"
    Display="always" Required="true" Mask="true"></Config>

  <!-- ==================== JWT ==================== -->
  <Config Name="JWT Secret" Target="JWT_SECRET" Default="" Mode=""
    Description="Secret key for JWT tokens. Generate: openssl rand -hex 64"
    Type="Variable" Display="always" Required="true" Mask="true"></Config>
  <Config Name="JWT Expires In" Target="JWT_EXPIRES_IN" Default="7d" Mode=""
    Description="JWT token expiry duration" Type="Variable"
    Display="advanced" Required="false" Mask="false">7d</Config>

  <!-- ==================== GOOGLE OAUTH ==================== -->
  <Config Name="Google Client ID" Target="GOOGLE_CLIENT_ID" Default="" Mode=""
    Description="Google OAuth Client ID from Google Cloud Console" Type="Variable"
    Display="always" Required="true" Mask="false"></Config>
  <Config Name="Google Client Secret" Target="GOOGLE_CLIENT_SECRET" Default="" Mode=""
    Description="Google OAuth Client Secret" Type="Variable"
    Display="always" Required="true" Mask="true"></Config>
  <Config Name="Google Callback URL" Target="GOOGLE_CALLBACK_URL"
    Default="https://dinnerbears.com/api/v1/auth/google/callback" Mode=""
    Description="Google OAuth callback URL" Type="Variable"
    Display="advanced" Required="true" Mask="false">https://dinnerbears.com/api/v1/auth/google/callback</Config>

  <!-- ==================== FACEBOOK OAUTH ==================== -->
  <Config Name="Facebook App ID" Target="FACEBOOK_APP_ID" Default="" Mode=""
    Description="Facebook App ID from Meta Developer Dashboard" Type="Variable"
    Display="always" Required="false" Mask="false"></Config>
  <Config Name="Facebook App Secret" Target="FACEBOOK_APP_SECRET" Default="" Mode=""
    Description="Facebook App Secret" Type="Variable"
    Display="always" Required="false" Mask="true"></Config>
  <Config Name="Facebook Callback URL" Target="FACEBOOK_CALLBACK_URL"
    Default="https://dinnerbears.com/api/v1/auth/facebook/callback" Mode=""
    Description="Facebook OAuth callback URL" Type="Variable"
    Display="advanced" Required="false" Mask="false">https://dinnerbears.com/api/v1/auth/facebook/callback</Config>

  <!-- ==================== FACEBOOK GROUPS ==================== -->
  <Config Name="FB Group 1 Cincinnati ID" Target="FACEBOOK_GROUP_1_CINCINNATI_ID" Default="" Mode=""
    Description="Facebook Group ID for Cincinnati Group 1" Type="Variable"
    Display="advanced" Required="false" Mask="false"></Config>
  <Config Name="FB Group 1 Dayton ID" Target="FACEBOOK_GROUP_1_DAYTON_ID" Default="" Mode=""
    Description="Facebook Group ID for Dayton Group 1" Type="Variable"
    Display="advanced" Required="false" Mask="false"></Config>
  <Config Name="FB Group 2 Dayton ID" Target="FACEBOOK_GROUP_2_DAYTON_ID" Default="" Mode=""
    Description="Facebook Group ID for Dayton Group 2 (secondary)" Type="Variable"
    Display="advanced" Required="false" Mask="false"></Config>

  <!-- ==================== EMAIL — BREVO ==================== -->
  <Config Name="Brevo API Key" Target="BREVO_API_KEY" Default="" Mode=""
    Description="Brevo API key for transactional email" Type="Variable"
    Display="always" Required="true" Mask="true"></Config>
  <Config Name="Brevo From Email" Target="BREVO_FROM_EMAIL"
    Default="noreply@dinnerbears.com" Mode=""
    Description="From address for outbound emails" Type="Variable"
    Display="always" Required="true" Mask="false">noreply@dinnerbears.com</Config>
  <Config Name="Brevo From Name" Target="BREVO_FROM_NAME" Default="DinnerBears" Mode=""
    Description="From name for outbound emails" Type="Variable"
    Display="advanced" Required="false" Mask="false">DinnerBears</Config>
  <Config Name="Brevo Webhook Secret" Target="BREVO_WEBHOOK_SECRET" Default="" Mode=""
    Description="Secret for validating Brevo webhook callbacks (bounce, spam, unsub)"
    Type="Variable" Display="advanced" Required="false" Mask="true"></Config>

  <!-- ==================== EMAIL — GMAIL SMTP FALLBACK ==================== -->
  <Config Name="Gmail User" Target="GMAIL_USER" Default="" Mode=""
    Description="Gmail address for SMTP overflow fallback" Type="Variable"
    Display="advanced" Required="false" Mask="false"></Config>
  <Config Name="Gmail App Password" Target="GMAIL_APP_PASSWORD" Default="" Mode=""
    Description="Gmail app password (not your Gmail password)" Type="Variable"
    Display="advanced" Required="false" Mask="true"></Config>

  <!-- ==================== EMAIL SUPPRESSION ==================== -->
  <Config Name="Email Suppression Salt" Target="EMAIL_SUPPRESSION_SALT" Default="" Mode=""
    Description="Salt for SHA-256 email hashing after hard delete. Generate: openssl rand -hex 32"
    Type="Variable" Display="advanced" Required="true" Mask="true"></Config>

  <!-- ==================== WEB PUSH / VAPID ==================== -->
  <Config Name="VAPID Public Key" Target="VAPID_PUBLIC_KEY" Default="" Mode=""
    Description="VAPID public key for Web Push. Generate: npx web-push generate-vapid-keys"
    Type="Variable" Display="advanced" Required="false" Mask="false"></Config>
  <Config Name="VAPID Private Key" Target="VAPID_PRIVATE_KEY" Default="" Mode=""
    Description="VAPID private key for Web Push" Type="Variable"
    Display="advanced" Required="false" Mask="true"></Config>
  <Config Name="VAPID Subject" Target="VAPID_SUBJECT"
    Default="mailto:admin@dinnerbears.com" Mode=""
    Description="VAPID subject (mailto or URL)" Type="Variable"
    Display="advanced" Required="false" Mask="false">mailto:admin@dinnerbears.com</Config>

  <!-- ==================== GEOCODING ==================== -->
  <Config Name="Geocoding API Key" Target="GEOCODING_API_KEY" Default="" Mode=""
    Description="Google Maps or other geocoding provider API key" Type="Variable"
    Display="advanced" Required="false" Mask="true"></Config>
  <Config Name="Geocoding Provider" Target="GEOCODING_PROVIDER" Default="google" Mode=""
    Description="Geocoding provider: google or opencage" Type="Variable"
    Display="advanced" Required="false" Mask="false">google</Config>

  <!-- ==================== APP ==================== -->
  <Config Name="App URL" Target="APP_URL" Default="https://dinnerbears.com" Mode=""
    Description="Public URL of the application" Type="Variable"
    Display="always" Required="true" Mask="false">https://dinnerbears.com</Config>
  <Config Name="Node Environment" Target="NODE_ENV" Default="production" Mode=""
    Description="production or development" Type="Variable"
    Display="advanced" Required="false" Mask="false">production</Config>
  <Config Name="Frontend Port" Target="FRONTEND_PORT" Default="8080" Mode=""
    Description="Internal frontend port" Type="Variable"
    Display="advanced" Required="false" Mask="false">8080</Config>
  <Config Name="API Port" Target="API_PORT" Default="3000" Mode=""
    Description="Internal API port" Type="Variable"
    Display="advanced" Required="false" Mask="false">3000</Config>

  <!-- ==================== PATHS ==================== -->
  <Config Name="Uploads Path" Target="/app/uploads"
    Default="/mnt/user/appdata/dinnerbears/latest/uploads" Mode="rw"
    Description="Persistent storage for uploaded restaurant photos"
    Type="Path" Display="always" Required="true" Mask="false">/mnt/user/appdata/dinnerbears/latest/uploads</Config>
  <Config Name="App Data Path" Target="/app/appdata"
    Default="/mnt/user/appdata/dinnerbears/latest" Mode="rw"
    Description="App data folder. Place a .env file here to override env vars via file"
    Type="Path" Display="advanced" Required="false" Mask="false">/mnt/user/appdata/dinnerbears/latest</Config>

</Container>
