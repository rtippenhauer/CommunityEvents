<?xml version="1.0"?>
<Container version="2">
  <Name>DinnerBears</Name>
  <Repository>dinnerbears/app</Repository>
  <Registry/>
  <Network>bridge</Network>
  <MyIP/>
  <Shell>bash</Shell>
  <Privileged>false</Privileged>
  <Support/>
  <Project>https://github.com/rtippenhauer/DinnerBears</Project>
  <Overview>DinnerBears community dining platform. Invite-only weekly dinner group for Cincinnati and Dayton. Runs Angular frontend + NestJS API via NGINX.</Overview>
  <Category>Tools:</Category>
  <WebUI>http://[IP]:[PORT:8080]/</WebUI>
  <TemplateURL/>
  <Icon/>
  <ExtraParams>--restart unless-stopped</ExtraParams>
  <PostArgs/>
  <CPUset/>
  <DateInstalled/>
  <DonateText/>
  <DonateLink/>
  <Requires/>

  <Config Name="Web Port" Target="8080" Default="8080" Mode="tcp" Description="Port for the DinnerBears web interface" Type="Port" Display="always" Required="true" Mask="false">8080</Config>

  <Config Name="DB Host" Target="DB_HOST" Default="192.168.2.241" Mode="" Description="MySQL host IP address" Type="Variable" Display="always" Required="true" Mask="false">192.168.2.241</Config>
  <Config Name="DB Port" Target="DB_PORT" Default="3306" Mode="" Description="MySQL port" Type="Variable" Display="always" Required="true" Mask="false">3306</Config>
  <Config Name="DB Name" Target="DB_NAME" Default="dinnerbears" Mode="" Description="MySQL database name" Type="Variable" Display="always" Required="true" Mask="false">dinnerbears</Config>
  <Config Name="DB User" Target="DB_USER" Default="dinnerbears_user" Mode="" Description="MySQL username" Type="Variable" Display="always" Required="true" Mask="false">dinnerbears_user</Config>
  <Config Name="DB Password" Target="DB_PASSWORD" Default="" Mode="" Description="MySQL password" Type="Variable" Display="always" Required="true" Mask="true"></Config>

  <Config Name="JWT Secret" Target="JWT_SECRET" Default="" Mode="" Description="Secret key for JWT tokens — use a long random string" Type="Variable" Display="always" Required="true" Mask="true"></Config>
  <Config Name="JWT Expires In" Target="JWT_EXPIRES_IN" Default="7d" Mode="" Description="JWT token expiry" Type="Variable" Display="advanced" Required="false" Mask="false">7d</Config>

  <Config Name="Google Client ID" Target="GOOGLE_CLIENT_ID" Default="" Mode="" Description="Google OAuth Client ID from Google Cloud Console" Type="Variable" Display="always" Required="true" Mask="false"></Config>
  <Config Name="Google Client Secret" Target="GOOGLE_CLIENT_SECRET" Default="" Mode="" Description="Google OAuth Client Secret" Type="Variable" Display="always" Required="true" Mask="true"></Config>

  <Config Name="Facebook App ID" Target="FACEBOOK_APP_ID" Default="" Mode="" Description="Facebook App ID from Meta Developer Dashboard" Type="Variable" Display="always" Required="false" Mask="false"></Config>
  <Config Name="Facebook App Secret" Target="FACEBOOK_APP_SECRET" Default="" Mode="" Description="Facebook App Secret" Type="Variable" Display="always" Required="false" Mask="true"></Config>

  <Config Name="Brevo API Key" Target="BREVO_API_KEY" Default="" Mode="" Description="Brevo (Sendinblue) API key for email sending" Type="Variable" Display="always" Required="true" Mask="true"></Config>
  <Config Name="Brevo From Email" Target="BREVO_FROM_EMAIL" Default="rob@dinnerbears.com" Mode="" Description="From address for outbound emails" Type="Variable" Display="always" Required="true" Mask="false">rob@dinnerbears.com</Config>
  <Config Name="Gmail User" Target="GMAIL_USER" Default="" Mode="" Description="Gmail address for SMTP fallback" Type="Variable" Display="advanced" Required="false" Mask="false"></Config>
  <Config Name="Gmail App Password" Target="GMAIL_APP_PASSWORD" Default="" Mode="" Description="Gmail app password for SMTP fallback" Type="Variable" Display="advanced" Required="false" Mask="true"></Config>

  <Config Name="Email Suppression Salt" Target="EMAIL_SUPPRESSION_SALT" Default="" Mode="" Description="Random salt for email hash suppression. Generate: openssl rand -hex 32" Type="Variable" Display="advanced" Required="true" Mask="true"></Config>

  <Config Name="VAPID Public Key" Target="VAPID_PUBLIC_KEY" Default="" Mode="" Description="VAPID public key for Web Push. Generate: npx web-push generate-vapid-keys" Type="Variable" Display="advanced" Required="false" Mask="false">BNgDaojnW0stGPCXsvdx-T8e26JOc7btJ_6djRqcueiDm1eNrZ1YtK39tazAypAughyLJVJsgS8q3KK5nKx6EJw</Config>
  <Config Name="VAPID Private Key" Target="VAPID_PRIVATE_KEY" Default="" Mode="" Description="VAPID private key for Web Push" Type="Variable" Display="advanced" Required="false" Mask="true"></Config>
  <Config Name="VAPID Subject" Target="VAPID_SUBJECT" Default="mailto:rtippenhauer@gmail.com" Mode="" Description="VAPID subject (mailto or URL)" Type="Variable" Display="advanced" Required="false" Mask="false">mailto:rtippenhauer@gmail.com</Config>

  <Config Name="Geocoding API Key" Target="GEOCODING_API_KEY" Default="" Mode="" Description="Google Maps or other geocoding API key" Type="Variable" Display="advanced" Required="false" Mask="true"></Config>

  <Config Name="App URL" Target="APP_URL" Default="https://dinnerbears.com" Mode="" Description="Public URL of the application" Type="Variable" Display="always" Required="true" Mask="false">https://dinnerbears.com</Config>
  <Config Name="Node Environment" Target="NODE_ENV" Default="production" Mode="" Description="production or development" Type="Variable" Display="advanced" Required="false" Mask="false">production</Config>

  <Config Name="App Data" Target="/app/uploads" Default="/mnt/user/appdata/dinnerbears/uploads" Mode="rw" Description="Persistent storage for uploaded photos and files" Type="Path" Display="always" Required="true" Mask="false">/mnt/user/appdata/dinnerbears/uploads</Config>
</Container>
