<?xml version="1.0"?>
<Container version="2">
  <Name>CommunityEvents-v2-Stage</Name>
  <Repository>rtippenhauer/community-events:v2-stage</Repository>
  <Registry/>
  <Network>bridge</Network>
  <MyIP/>
  <Shell>bash</Shell>
  <Privileged>false</Privileged>
  <Support/>
  <Project>https://github.com/rtippenhauer/CommunityEvents</Project>
  <Overview>CommunityEvents v2 rewrite — stage container. Tracks the :v2-stage image tag, pushed by /v2-testing and /v2-done as v2 items land. Points at its own communityevents database, separate from v1 DinnerBears.</Overview>
  <Category>Tools:</Category>
  <WebUI>http://[IP]:[PORT:8082]/</WebUI>
  <TemplateURL/>
  <Icon/>
  <ExtraParams>--restart unless-stopped</ExtraParams>
  <PostArgs/>
  <CPUset/>
  <DateInstalled/>
  <DonateText/>
  <DonateLink/>
  <Requires/>

  <Config Name="Web Port" Target="8080" Default="8082" Mode="tcp" Description="Host port for the stage web interface. Default 8082, not 8080, so it doesn't collide with the v1 DinnerBears container if both run at once — confirm against whatever's already in use on this Unraid box." Type="Port" Display="always" Required="true" Mask="false">8082</Config>

  <Config Name="DB Host" Target="DB_HOST" Default="192.168.2.241" Mode="" Description="MySQL host IP address (same server as v1's, different database)" Type="Variable" Display="always" Required="true" Mask="false">192.168.2.241</Config>
  <Config Name="DB Port" Target="DB_PORT" Default="3306" Mode="" Description="MySQL port" Type="Variable" Display="always" Required="true" Mask="false">3306</Config>
  <Config Name="DB Name" Target="DB_NAME" Default="communityevents" Mode="" Description="MySQL database name — the dedicated v2 database, never dinnerbears" Type="Variable" Display="always" Required="true" Mask="false">communityevents</Config>
  <Config Name="DB User" Target="DB_USER" Default="communityevents_user" Mode="" Description="MySQL username" Type="Variable" Display="always" Required="true" Mask="false">communityevents_user</Config>
  <Config Name="DB Password" Target="DB_PASSWORD" Default="" Mode="" Description="MySQL password for the communityevents_user account" Type="Variable" Display="always" Required="true" Mask="true"></Config>

  <Config Name="JWT Secret" Target="JWT_SECRET" Default="" Mode="" Description="Secret key for JWT tokens — generate a new one, don't reuse v1's. openssl rand -hex 32" Type="Variable" Display="always" Required="true" Mask="true"></Config>
  <Config Name="Secret Encryption Key" Target="SECRET_ENCRYPTION_KEY" Default="" Mode="" Description="Encrypts every credential stored in the database (v2-7). Leave EMPTY on a new install and one is generated on first start, written to the appdata volume -- back that file up. Set it only to supply a key an existing database already needs. Generate: openssl rand -base64 32" Type="Variable" Display="always" Required="false" Mask="true"></Config>
  <Config Name="Retired Encryption Keys" Target="SECRET_ENCRYPTION_KEYS_RETIRED" Default="" Mode="" Description="Previous encryption keys, comma-separated, decrypt-only. Leave empty except while rotating — see npm run secrets:rewrap." Type="Variable" Display="advanced" Required="false" Mask="true"></Config>
  <Config Name="JWT Expires In" Target="JWT_EXPIRES_IN" Default="7d" Mode="" Description="JWT token expiry" Type="Variable" Display="advanced" Required="false" Mask="false">7d</Config>

  <Config Name="Google Client ID" Target="GOOGLE_CLIENT_ID" Default="" Mode="" Description="Google OAuth Client ID. Whatever APP_URL you set below needs its own authorized redirect URI (APP_URL + /api/v1/auth/google/callback) added to this client, or a separate client entirely" Type="Variable" Display="always" Required="true" Mask="false"></Config>
  <Config Name="Google Client Secret" Target="GOOGLE_CLIENT_SECRET" Default="" Mode="" Description="Google OAuth Client Secret" Type="Variable" Display="always" Required="true" Mask="true"></Config>

  <Config Name="Facebook App ID" Target="FACEBOOK_APP_ID" Default="" Mode="" Description="Facebook App ID — leave unset to hide the Facebook login button" Type="Variable" Display="always" Required="false" Mask="false"></Config>
  <Config Name="Facebook App Secret" Target="FACEBOOK_APP_SECRET" Default="" Mode="" Description="Facebook App Secret" Type="Variable" Display="always" Required="false" Mask="true"></Config>

  <Config Name="Brevo API Key" Target="BREVO_API_KEY" Default="" Mode="" Description="Brevo API key for primary email sending" Type="Variable" Display="always" Required="true" Mask="true"></Config>
  <Config Name="Brevo From Email" Target="BREVO_FROM_EMAIL" Default="" Mode="" Description="From address for outbound emails" Type="Variable" Display="always" Required="true" Mask="false"></Config>

  <Config Name="Resend API Key" Target="RESEND_API_KEY" Default="" Mode="" Description="Resend API key — optional overflow email provider" Type="Variable" Display="advanced" Required="false" Mask="true"></Config>
  <Config Name="Resend From Email" Target="RESEND_FROM_EMAIL" Default="" Mode="" Description="Resend overflow from-address" Type="Variable" Display="advanced" Required="false" Mask="false"></Config>
  <Config Name="Resend From Name" Target="RESEND_FROM_NAME" Default="" Mode="" Description="Resend overflow from-name" Type="Variable" Display="advanced" Required="false" Mask="false"></Config>

  <Config Name="Email Suppression Salt" Target="EMAIL_SUPPRESSION_SALT" Default="" Mode="" Description="Random salt for email hash suppression. Generate: openssl rand -hex 32" Type="Variable" Display="advanced" Required="true" Mask="true"></Config>

  <Config Name="VAPID Public Key" Target="VAPID_PUBLIC_KEY" Default="" Mode="" Description="VAPID public key for Web Push. Generate: npx web-push generate-vapid-keys" Type="Variable" Display="advanced" Required="false" Mask="false"></Config>
  <Config Name="VAPID Private Key" Target="VAPID_PRIVATE_KEY" Default="" Mode="" Description="VAPID private key for Web Push" Type="Variable" Display="advanced" Required="false" Mask="true"></Config>
  <Config Name="VAPID Subject" Target="VAPID_SUBJECT" Default="" Mode="" Description="VAPID subject (mailto: or URL)" Type="Variable" Display="advanced" Required="false" Mask="false"></Config>

  <Config Name="Geocoding API Key" Target="GEOCODING_API_KEY" Default="" Mode="" Description="Google Geocoding API key" Type="Variable" Display="advanced" Required="false" Mask="true"></Config>
  <Config Name="Google Places API Key" Target="GOOGLE_PLACES_API_KEY" Default="" Mode="" Description="Google Places API key (location enrichment)" Type="Variable" Display="advanced" Required="false" Mask="true"></Config>
  <Config Name="Anthropic API Key" Target="ANTHROPIC_API_KEY" Default="" Mode="" Description="Optional — powers the admin 'enrich location' helper. Leave unset to disable it" Type="Variable" Display="advanced" Required="false" Mask="true"></Config>

  <Config Name="Cloudflare Email Secret" Target="CLOUDFLARE_EMAIL_SECRET" Default="" Mode="" Description="Shared secret validating inbound Cloudflare Email Routing webhook calls (calendar RSVP replies)" Type="Variable" Display="advanced" Required="false" Mask="true"></Config>

  <Config Name="Admin Email" Target="ADMIN_EMAIL" Default="" Mode="" Description="Email address granted admin on first login" Type="Variable" Display="advanced" Required="false" Mask="false"></Config>

  <Config Name="App URL" Target="APP_URL" Default="" Mode="" Description="Public URL for this stage instance, e.g. https://v2-stage.dinnerbears.com — needs its own DNS record and reverse-proxy entry; decide this before first boot" Type="Variable" Display="always" Required="true" Mask="false"></Config>
  <Config Name="Base Domain" Target="BASE_DOMAIN" Default="" Mode="" Description="Bare domain for derived contact emails (NOT the session cookie scope -- v2-6 made that cookie host-only). Optional — defaults to APP_URL's host with a leading www. stripped. Use the bare domain, never www., since www.<domain> normally has no MX record" Type="Variable" Display="advanced" Required="false" Mask="false"></Config>
  <Config Name="Calendar Organizer Email" Target="CALENDAR_ORGANIZER_EMAIL" Default="" Mode="" Description="Optional override — defaults to calendar@BASE_DOMAIN" Type="Variable" Display="advanced" Required="false" Mask="false"></Config>
  <Config Name="Event Organizer Email" Target="EVENT_ORGANIZER_EMAIL" Default="" Mode="" Description="Optional override — defaults to noreply@BASE_DOMAIN" Type="Variable" Display="advanced" Required="false" Mask="false"></Config>
  <Config Name="Support Email" Target="SUPPORT_EMAIL" Default="" Mode="" Description="Optional override — defaults to hello@BASE_DOMAIN" Type="Variable" Display="advanced" Required="false" Mask="false"></Config>

  <Config Name="Node Environment" Target="NODE_ENV" Default="production" Mode="" Description="Must be 'production' even on stage — a value of 'staging' leaves cookies non-Secure and can leak stack traces. Stage-vs-prod is controlled entirely by IS_STAGE below" Type="Variable" Display="always" Required="true" Mask="false">production</Config>
  <Config Name="Is Stage" Target="IS_STAGE" Default="true" Mode="" Description="true for this container — flags the UI as a stage build. Must be paired with NODE_ENV=production, not 'staging'" Type="Variable" Display="always" Required="true" Mask="false">true</Config>

  <Config Name="Legal Entity Name" Target="LEGAL_ENTITY_NAME" Default="" Mode="" Description="The company or person operating this deployment, named in the Terms of Service and Privacy Policy every community starts with. Deployment-wide on purpose: one operator runs every community here. Leave empty and each community's legal pages name the community itself, which is right only when the two are the same." Type="Variable" Display="always" Required="false" Mask="false"></Config>

  <Config Name="Uploads" Target="/app/uploads" Default="/mnt/user/appdata/communityevents-v2-stage/uploads" Mode="rw" Description="Persistent storage for uploaded photos and files — separate path from v1's dinnerbears/uploads" Type="Path" Display="always" Required="true" Mask="false">/mnt/user/appdata/communityevents-v2-stage/uploads</Config>

  <!-- REQUIRED, and easy to miss: a generated encryption key is written here.
       Without this mapping the key lives only inside the container, so every
       recreate silently generates a new one and the startup log says to back up
       a file that cannot survive. Found exactly that way on stage. -->
  <Config Name="App Data" Target="/app/appdata" Default="/mnt/user/appdata/communityevents-v2-stage/appdata" Mode="rw" Description="Persistent storage for the secret encryption key (and an optional .env). MUST be mapped: without it a generated key is lost on every container recreate, and the deployment then refuses to start once any secret is stored under the old one." Type="Path" Display="always" Required="true" Mask="false">/mnt/user/appdata/communityevents-v2-stage/appdata</Config>

  <!-- One-time instance bootstrap (api/src/bootstrap.ts). Not read by the app
       itself at boot — only by `docker exec <container> node /app/dist/bootstrap.js`,
       run once by hand after the container is up and migrations have completed.
       Baking these in as container env vars means that command needs no -e
       flags: docker exec inherits the container's own environment. Re-running
       is a safe no-op (idempotent upserts) unless real members already exist,
       in which case it refuses unless INSTANCE_BOOTSTRAP_FORCE=true. -->
  <Config Name="Instance City Name" Target="INSTANCE_CITY_NAME" Default="Default" Mode="" Description="Required for bootstrap. Your region/community name — bootstrap.ts exits with an error if this is unset when you run it. 'Default' for this stage instance since it isn't a real city" Type="Variable" Display="always" Required="true" Mask="false">Default</Config>
  <Config Name="Instance City Subdomain" Target="INSTANCE_CITY_SUBDOMAIN" Default="" Mode="" Description="Optional — defaults to a slug of Instance City Name" Type="Variable" Display="advanced" Required="false" Mask="false"></Config>
  <Config Name="Instance Brand Name" Target="INSTANCE_BRAND_NAME" Default="" Mode="" Description="Optional — leave unset to keep editing later in Admin → Site Settings" Type="Variable" Display="advanced" Required="false" Mask="false"></Config>
  <Config Name="Instance Brand Tagline" Target="INSTANCE_BRAND_TAGLINE" Default="" Mode="" Description="Optional" Type="Variable" Display="advanced" Required="false" Mask="false"></Config>
  <Config Name="Instance Theme Primary" Target="INSTANCE_THEME_PRIMARY" Default="" Mode="" Description="Optional, #RRGGBB" Type="Variable" Display="advanced" Required="false" Mask="false"></Config>
  <Config Name="Instance Theme Accent" Target="INSTANCE_THEME_ACCENT" Default="" Mode="" Description="Optional, #RRGGBB" Type="Variable" Display="advanced" Required="false" Mask="false"></Config>
  <Config Name="Instance Theme Background" Target="INSTANCE_THEME_BACKGROUND" Default="" Mode="" Description="Optional, #RRGGBB" Type="Variable" Display="advanced" Required="false" Mask="false"></Config>
  <Config Name="Instance Admin Email" Target="INSTANCE_ADMIN_EMAIL" Default="" Mode="" Description="Required for bootstrap. Your login for this instance's first admin account" Type="Variable" Display="always" Required="true" Mask="false"></Config>
  <Config Name="Instance Admin Name" Target="INSTANCE_ADMIN_NAME" Default="" Mode="" Description="Optional — defaults to 'Admin'" Type="Variable" Display="advanced" Required="false" Mask="false"></Config>
  <Config Name="Instance Admin Password" Target="INSTANCE_ADMIN_PASSWORD" Default="" Mode="" Description="Required for bootstrap. Password for the first admin sign-in — pick your own, don't reuse a real credential for a stage instance" Type="Variable" Display="always" Required="true" Mask="true"></Config>
  <Config Name="Instance Bootstrap Force" Target="INSTANCE_BOOTSTRAP_FORCE" Default="false" Mode="" Description="Leave false. Only set true to re-run bootstrap against a database that already has real members — normally you want the safety refusal" Type="Variable" Display="advanced" Required="false" Mask="false">false</Config>
</Container>
